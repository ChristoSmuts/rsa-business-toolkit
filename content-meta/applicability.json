      "reason": "The rows say \"if you run payroll\" or \"if an employer\": EMP201 and EMP501 are employer returns."
    },
    {
      "docs": ["lookup/checklist"],
      "headings": ["part-c-recurring-calendar"],
      "pattern": "\\bif (?:you have )?a company\\b|\\bcompany tax return\\b",
      "appliesTo": {
        "entity": "pty"
      },
      "reason": "The rows say \"if you have a company\" or \"company tax return\": the CIPC annual return and the ITR14 apply to companies only."
    },
    {
      "docs": ["lookup/checklist"],
      "headings": ["part-c-recurring-calendar"],
      "pattern": "\\bdirector's loan account\\b",
      "appliesTo": {
        "entity": "pty"
      },
      "reason": "Only a company has a director's loan account; 01 Core/07-paying-yourself.md covers it as a company duty."
    },
    {
      "docs": ["lookup/checklist"],
      "headings": ["part-c-recurring-calendar"],
      "pattern": "\\bbeneficial ownership declaration\\b",
      "appliesTo": {
        "entity": "pty"
      },
      "reason": "Beneficial ownership filing with CIPC applies to companies; 01 Core/06-running-a-pty-ltd.md covers it as a company duty."
    }
  ]
