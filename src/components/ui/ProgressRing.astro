---
/**
 * Progress ring. The SVG is `role="img"` with a full text label ("12 of 34 done"), so the
 * number is never conveyed by the arc alone.
 *
 * Nothing moves when a page opens: the arc shows the value it opens with. Only a change on the
 * page (a step marked done, a tick) moves the arc, in `--st-duration-base`. `drawRing()`
 * (`src/scripts/ring.ts`) sets `data-animate` after its first drawing, so a ring that the script
 * fills in after load does not animate either. The top bar's ring drew in for 960ms on every page
 * view before (WP-50 audit, `review-animations` verdict Block). Reduced motion sets the duration
 * to 0.
 */
interface Props {
  value: number;
  max?: number | undefined;
  /** Accessible label, for example "Part A: 12 of 34 done". */
  label: string;
  /** Diameter in CSS px. */
  size?: number | undefined;
  /** Show the percentage in the middle (hidden from assistive tech; the label carries it). */
  showValue?: boolean | undefined;
  class?: string | undefined;
}

const { value, max = 100, label, size = 56, showValue = true, class: className } = Astro.props;
const safeMax = max > 0 ? max : 1;
const percent = Math.round(Math.min(1, Math.max(0, value / safeMax)) * 100);
const complete = percent >= 100;
---

<span
  class:list={['st-ring', className]}
  data-complete={complete ? 'true' : undefined}
  style={`--st-ring-size: ${size}px`}
>
  <svg viewBox="0 0 36 36" width={size} height={size} role="img" aria-label={label}>
    <circle class="st-ring__track" cx="18" cy="18" r="15.5"></circle>
    <circle
      class="st-ring__value"
      cx="18"
      cy="18"
      r="15.5"
      pathLength="100"
      stroke-dasharray="100"
      stroke-dashoffset={100 - percent}
      transform="rotate(-90 18 18)"
    ></circle>
  </svg>
  {showValue && (
    <span class="st-ring__text" aria-hidden="true">
      {percent}%
    </span>
  )}
</span>

<style>
  .st-ring {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: var(--st-ring-size);
    block-size: var(--st-ring-size);
    flex-shrink: 0;
  }

  .st-ring svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .st-ring__track,
  .st-ring__value {
    fill: none;
    stroke-width: 3.5;
  }

  .st-ring__track {
    stroke: var(--st-border);
  }

  .st-ring__value {
    stroke: var(--st-primary);
    stroke-linecap: round;
  }

  .st-ring[data-animate] .st-ring__value {
    transition: stroke-dashoffset var(--st-duration-base) var(--st-ease);
  }

  .st-ring[data-complete='true'] .st-ring__value {
    stroke-linecap: butt;
  }

  .st-ring__text {
    position: absolute;
    color: var(--st-text);

    /* 0.22 keeps "100%" clear of the stroke (inner diameter is 28/36 of the ring). */
    font-size: calc(var(--st-ring-size) * 0.22);
    font-weight: var(--st-weight-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  @media (forced-colors: active) {
    .st-ring__track {
      stroke: GrayText;
    }

    .st-ring__value {
      stroke: CanvasText;
    }
  }
</style>
