---
/**
 * A fenced block: an AI prompt, a template preview, a worked example, a listing or a snippet.
 *
 * Every variant renders as preformatted text that is complete and readable on its own. The copy
 * button is WP-30 and must only ever be an enhancement: nothing here depends on JavaScript, and
 * the full text is always in the page, never clamped away.
 *
 * Where the pipeline recorded placeholders (prompts and template previews), they are marked in
 * place with `splitPlaceholders`, so the blanks a reader has to replace are visible. The marks
 * are inside the `<pre>`, so selecting and copying the block by hand still yields the text with
 * its `[BRACKETS]`.
 *
 * The `<pre>` keeps `white-space: pre` — a template preview is a layout, and wrapping it would
 * garble it — so it scrolls sideways on a phone and is therefore a scrollable region, which WCAG
 * 2.1.1 says a keyboard must reach. The server renders it as a named region with `tabindex="0"`;
 * axe reported every fenced block as `scrollable-region-focusable` without it. A block that fits
 * would then be an unnamed, silent tab stop, so `<st-code-scroll>` drops the stop and the role
 * while nothing overflows, as `TableScroll` does for tables. With JavaScript off every block keeps
 * its stop, which costs a Tab press but never strands a keyboard user.
 */
import { useTranslations } from '../../i18n';
import type { ContentContext } from '../../lib/content/context';
import { splitPlaceholders } from '../../lib/content/render';
import type { Block } from '../../lib/content/schema';

interface Props {
  block: Extract<Block, { kind: 'code' }>;
  context: ContentContext;
  /** Names the region: the heading above the block, or the page title. */
  caption: string;
}

const { block, context, caption } = Astro.props;
const t = useTranslations(context.contentLang);
const label = t('doc.codeRegion', { caption });
const segments = splitPlaceholders(block.text, block.placeholders);
const hasPlaceholders = segments.some((segment) => segment.kind === 'placeholder');
---

<figure class="st-code" data-variant={block.variant}>
  <st-code-scroll>
    <pre
      role="region"
      tabindex="0"
      aria-label={label}
      data-label={label}
    ><code>{segments.map((segment) => (segment.kind === 'text' ? segment.value : <mark class="st-placeholder" data-placeholder={segment.run.style}>{segment.value}</mark>))}</code></pre>
  </st-code-scroll>
  {hasPlaceholders && <figcaption>{t('prompts.placeholderHint')}</figcaption>}
</figure>

<script>
  import '../../scripts/code-scroll';
</script>
