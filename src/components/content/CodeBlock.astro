---
/**
 * A fenced block: an AI prompt, a template preview, a worked example, a listing or a snippet.
 *
 * Every variant renders as preformatted text that is complete and readable on its own. The copy
 * button is WP-30 and must only ever be an enhancement: nothing here depends on JavaScript, and
 * the full text is always in the page, never clamped away.
 *
 * Where the pipeline recorded placeholders (prompts and template previews), they are marked in
 * place with `splitPlaceholders`, so the blanks a reader has to replace are visible. The marks
 * are inside the `<pre>`, so selecting and copying the block by hand still yields the text with
 * its `[BRACKETS]`.
 *
 * Prompts, snippets and examples wrap (`content.css`), because they are prose. Template previews
 * and listings keep `white-space: pre` — they are layouts, and wrapping would garble them — so they
 * scroll sideways on a phone and are scrollable regions, which WCAG 2.1.1 says a keyboard must
 * reach. The server renders it as a named region with `tabindex="0"`;
 * axe reported every fenced block as `scrollable-region-focusable` without it. A block that fits
 * would then be an unnamed, silent tab stop, so `<st-code-scroll>` drops the stop and the role
 * while nothing overflows, as `TableScroll` does for tables. With JavaScript off every block keeps
 * its stop, which costs a Tab press but never strands a keyboard user.
 */
import Button from '../ui/Button.astro';
import { useTranslations } from '../../i18n';
import { getLocale } from '../../i18n/locales';
import { isFallbackContent, type ContentContext } from '../../lib/content/context';
import { splitPlaceholders } from '../../lib/content/render';
import type { Block } from '../../lib/content/schema';

interface Props {
  block: Extract<Block, { kind: 'code' }>;
  context: ContentContext;
  /** Names the region: the heading above the block, or the page title. */
  caption: string;
  /** A prompt's number on the page ("Copy prompt 2: …"). */
  promptNumber?: number | undefined;
}

const { block, context, caption, promptNumber } = Astro.props;
const t = useTranslations(context.contentLang);
const label = t('doc.codeRegion', { caption });
const segments = splitPlaceholders(block.text, block.placeholders);
const hasPlaceholders = segments.some((segment) => segment.kind === 'placeholder');
/** Layouts keep `white-space: pre` and can scroll; prose variants wrap and never do. */
const scrolls = block.variant === 'template-preview' || block.variant === 'listing';

const isPrompt = block.variant === 'prompt';
const siteT = useTranslations(context.locale);
const siteLang = isFallbackContent(context)
  ? (getLocale(context.locale)?.hreflang ?? context.locale)
  : undefined;
/** Stable across builds and languages: the block id is the same in every translation. */
const promptId = context.docId ? `${context.docId}#${block.id}` : block.id;
const copyName =
  promptNumber === undefined
    ? undefined
    : siteT('prompts.copyNamed', { n: promptNumber, title: caption });
const copiedMessage =
  promptNumber === undefined
    ? siteT('prompts.copied')
    : siteT('prompts.copiedNamed', { n: promptNumber });
---

<figure class="st-code" data-variant={block.variant}>
  <st-code-scroll>
    <pre
      role={scrolls ? 'region' : undefined}
      tabindex={scrolls ? 0 : undefined}
      aria-label={scrolls ? label : undefined}
      data-label={scrolls ? label : undefined}
    ><code>{segments.map((segment) => (segment.kind === 'text' ? segment.value : <mark class="st-placeholder" data-placeholder={segment.run.style}>{segment.value}</mark>))}</code></pre>
  </st-code-scroll>
  {hasPlaceholders && <figcaption>{t('prompts.placeholderHint')}</figcaption>}
  {isPrompt && (
    <st-copy
      class="st-copy st-no-print"
      lang={siteLang}
      data-prompt-id={promptId}
      data-copied={siteT('prompts.copied')}
      data-copied-message={copiedMessage}
      data-failed-message={siteT('prompts.copyFailed')}
    >
      <Button
        variant="secondary"
        class="st-copy__button"
        iconStart="lucide:copy"
        aria-label={copyName}
        hidden
      >
        {siteT('prompts.copy')}
      </Button>
      <p class="st-hint st-copy__status" role="status"></p>
    </st-copy>
  )}
</figure>

<script>
  import '../../scripts/code-scroll';
  import '../../scripts/copy';
</script>

<style>
  .st-copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--st-space-2) var(--st-space-3);
  }

  .st-copy__status {
    min-inline-size: 0;
    flex: 1 1 12rem;
  }
</style>
