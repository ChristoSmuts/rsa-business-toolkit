---
/**
 * A document's body: every block in order.
 *
 * When the blocks are not in the page's language (an English document shown on an Afrikaans
 * route), the wrapper carries `lang` so a screen reader switches voice, per plan B5.
 */
import Block from './Block.astro';
import '../../styles/content.css';
import type { ContentContext } from '../../lib/content/context';
import { isFallbackContent } from '../../lib/content/context';
import { headingTags, isRedundantRule, nearestHeadingText } from '../../lib/content/render';
import type { Block as ContentBlock } from '../../lib/content/schema';
import { useTranslations } from '../../i18n';
import { getLocale } from '../../i18n/locales';

interface Props {
  blocks: readonly ContentBlock[];
  context: ContentContext;
  /** Names a table that has no heading above it. */
  fallbackCaption: string;
  class?: string | undefined;
  /**
   * Render every heading one level lower (`##` as `<h3>`), for blocks shown under a heading of
   * the page's own, such as the master checklist's parts on My path (WP-31).
   */
  nested?: boolean | undefined;
}

const { blocks, context, fallbackCaption, class: className, nested = false } = Astro.props;
const lang = isFallbackContent(context)
  ? (getLocale(context.contentLang)?.hreflang ?? context.contentLang)
  : undefined;
const LOWER = { h2: 'h3', h3: 'h4', h4: 'h5' } as const;
const tags = headingTags(blocks).map((tag) => (nested && tag ? LOWER[tag] : tag));
const firstTasklist = blocks.findIndex((block) => block.kind === 'tasklist');
/*
 * A prompt is named by the heading above it, which carries the guide's own numbering ("Prompt 0:
 * the business brief"). A count of prompts in page order named that prompt "Prompt 4" (WP-50 audit,
 * flow 6). Where one heading has more than one prompt, each also says which of them it is.
 */
const siteT = useTranslations(context.locale);
const captions = blocks.map((_, index) => nearestHeadingText(blocks, index) ?? fallbackCaption);
const isPrompt = (block: ContentBlock): boolean =>
  block.kind === 'code' && block.variant === 'prompt';
const promptTitles = blocks.map((block, index) => {
  if (!isPrompt(block)) return undefined;
  const title = captions[index] ?? fallbackCaption;
  const same = blocks
    .map((other, position) => (isPrompt(other) && captions[position] === title ? position : -1))
    .filter((position) => position >= 0);
  return same.length < 2
    ? title
    : siteT('prompts.titlePart', { title, n: same.indexOf(index) + 1, total: same.length });
});
const visible = blocks
  .map((block, index) => ({
    block,
    promptTitle: promptTitles[index],
    headingTag: tags[index],
    firstTasklist: index === firstTasklist,
    caption: captions[index] ?? fallbackCaption,
    redundant: isRedundantRule(blocks, index),
  }))
  .filter((entry) => !entry.redundant);
---

<div class:list={['st-blocks', className]} lang={lang}>
  {visible.map((entry) => (
    <Block
      block={entry.block}
      context={context}
      caption={entry.caption}
      headingTag={entry.headingTag}
      firstTasklist={entry.firstTasklist}
      promptTitle={entry.promptTitle}
    />
  ))}
</div>
