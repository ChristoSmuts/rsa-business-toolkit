---
/**
 * "On this page" (build plan B2, B6). Two presentations of the same headings:
 *
 * - `variant="details"`: a native `<details>` under the article header, shown below 1280px;
 * - `variant="column"`: the third grid column, shown from 1280px.
 *
 * Only one of the two is displayed at any width, so a screen reader is never offered the list
 * twice. The list itself is plain links to heading ids, which work with no JavaScript at all.
 *
 * `<st-toc>` (`src/scripts/toc.ts`, WP-30) adds scroll-spy: the link to the section being read
 * gets `aria-current="location"`. Below 1280px it also fills a sticky "Now reading" pill under the
 * top bar, which links back to this list; its name says so ("Now reading: Tax basics. Open the
 * list of sections."). The element is `display: contents`, so the column stays
 * the grid item and the pill sticks inside the article. The reading-progress ring is a later
 * package.
 *
 * Pseudo headings (depth 4, a bold lead-in line) and hidden headings are left out: the contents
 * of a page should be its sections, not every bold line in it.
 */
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { DocHeading } from '../../lib/content/schema';

interface Props {
  headings: readonly DocHeading[];
  locale: Locale;
  variant: 'details' | 'column';
  /** BCP 47 tag of the headings' language, when it is not the page's (an English fallback). */
  contentLang?: string | undefined;
  class?: string | undefined;
}

const { headings, locale, variant, contentLang, class: className } = Astro.props;
const t = useTranslations(locale);
const items = headings.filter(
  (heading) => heading.depth <= 3 && !heading.pseudo && !heading.hidden,
);
const label = t('nav.onThisPageCount', { count: items.length });
/** The `<details>` the pill links back to. */
const detailsId = 'st-on-this-page';
---

{items.length > 0 &&
  (variant === 'details' ? (
    <st-toc class="st-toc-host">
      <details class:list={['st-toc', 'st-toc--details', 'st-no-print', className]} id={detailsId}>
        <summary class="st-toc__summary">{label}</summary>
        <nav aria-label={t('nav.onThisPage')}>
          <ul class="st-toc__list" role="list" lang={contentLang}>
            {items.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.id}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
      <div class="st-toc__pill-track js-only st-no-print">
        <a
          class="st-toc__pill"
          href={`#${detailsId}`}
          data-toc-pill
          data-label-template={t('nav.currentSectionLabel', { title: '{title}' })}
          hidden
        >
          <span class="st-toc__pill-label">{t('nav.currentSection')}</span>
          <span class="st-toc__pill-text" data-toc-pill-text lang={contentLang}></span>
        </a>
      </div>
    </st-toc>
  ) : (
    <st-toc class="st-toc-host">
      <nav class:list={['st-toc', 'st-toc--column', className]} aria-label={t('nav.onThisPage')}>
        <p class="st-toc__title">{t('nav.onThisPage')}</p>
        <ul class="st-toc__list" role="list" lang={contentLang}>
          {items.map((heading) => (
            <li data-depth={heading.depth}>
              <a href={`#${heading.id}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </st-toc>
  ))}

<script>
  import '../../scripts/toc';
</script>

<style is:global>
  /*
   * Below 1280px, with JavaScript, a page with the "Now reading" pill keeps room for it in the
   * scroll padding (`SiteHeader.astro` adds `--st-toc-pill-space` to the top bar's offset).
   */
  @media (width < 1280px) {
    html.js:has(.st-toc__pill-track) {
      --st-toc-pill-space: calc(var(--st-target) + 1lh + var(--st-space-2));
    }
  }
</style>

<style>
  .st-toc-host {
    display: contents;
  }

  .st-toc__summary {
    display: flex;
    align-items: center;
    min-block-size: var(--st-target);
    font-weight: var(--st-weight-semibold);
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .st-toc__title {
    color: var(--st-text-muted);
    font-size: var(--st-text-sm);
    font-weight: var(--st-weight-semibold);
  }

  .st-toc__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0;
    list-style: none;
  }

  .st-toc__list a {
    display: block;
    min-block-size: var(--st-target);
    padding-block: max(0px, calc((var(--st-target) - 1lh) / 2));
    color: var(--st-text);
    overflow-wrap: anywhere;
  }

  .st-toc__list a:visited {
    color: var(--st-text);
  }

  .st-toc__list li[data-depth='3'] a {
    padding-inline-start: var(--st-space-4);
  }

  /* The section being read (scroll-spy). A bar and weight, never colour alone. */
  .st-toc__list a[aria-current='location'] {
    box-shadow: inset var(--st-stripe-width) 0 0 var(--st-primary);
    padding-inline-start: var(--st-space-3);
    font-weight: var(--st-weight-semibold);
  }

  .st-toc__list li[data-depth='3'] a[aria-current='location'] {
    padding-inline-start: var(--st-space-5);
  }

  /*
   * The "Now reading" pill. Its track is sticky inside the article and has no height, so the pill
   * hangs below the top bar without moving the text when it appears or goes. The title wraps and
   * is never cut off (house rule 8: an ellipsis hid the end of translated headings, WP-50 audit).
   * The label and the title run as one line of text, so the title has the pill's whole width: most
   * headings fit on one line at 320px and nearly all on two. The global rule above keeps two lines
   * of room in the scroll padding, so a heading reached by a contents link, or focus moved by the
   * keyboard, lands below a one- or two-line pill, not under it.
   */
  .st-toc__pill-track {
    position: sticky;
    inset-block-start: var(--st-topbar-offset, 0);
    z-index: var(--st-z-sticky);
    block-size: 0;
  }

  .st-toc__pill {
    display: block;
    inline-size: fit-content;
    max-inline-size: 100%;
    min-block-size: var(--st-target);
    margin-block-start: var(--st-space-2);
    padding-block: max(0px, calc((var(--st-target) - 1lh) / 2 - var(--st-border-width)));
    padding-inline: var(--st-space-4);
    border: var(--st-border-width) solid var(--st-border-strong);

    /* An exact pill on one line, and a rounded box, not an oval, when the title wraps. */
    border-radius: calc(var(--st-target) / 2);
    background-color: var(--st-surface);
    box-shadow: var(--st-shadow-1);
    color: var(--st-text);
    animation: st-toc-pill-in var(--st-duration-base) var(--st-ease) both;
  }

  .st-toc__pill:visited {
    color: var(--st-text);
  }

  .st-toc__pill-label {
    margin-inline-end: var(--st-space-2);
    color: var(--st-text-muted);
    font-size: var(--st-text-sm);
    font-weight: var(--st-weight-semibold);
  }

  .st-toc__pill-text {
    font-weight: var(--st-weight-semibold);
    overflow-wrap: anywhere;
  }

  @keyframes st-toc-pill-in {
    from {
      opacity: 0;
    }
  }

  /* Exactly one of the two presentations is shown at any width. */
  @media (width >= 1280px) {
    .st-toc--details {
      display: none;
    }
  }

  @media (width < 1280px) {
    .st-toc--column {
      display: none;
    }
  }

  @media (width >= 1280px) {
    .st-toc__pill-track {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .st-toc__list a[aria-current='location'] {
      box-shadow: none;
      border-inline-start: var(--st-stripe-width) solid CanvasText;
    }
  }

  @media (width >= 1280px) {
    /*
     * A sticky grid item stretches to its row unless told not to, and with a viewport-high cap its
     * own grid then spreads the title and the list over the whole screen.
     */
    .st-toc--column {
      position: sticky;
      inset-block-start: calc(var(--st-topbar) + var(--st-space-4));
      display: grid;
      align-self: start;
      align-content: start;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--st-space-2);
      max-block-size: calc(100vh - var(--st-topbar) - var(--st-space-6));
      overflow-y: auto;
    }
  }
</style>
