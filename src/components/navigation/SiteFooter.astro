---
/**
 * The footer (build plan B2, B4 FooterDisclaimer; WP-50 Phase 3, item 5).
 *
 * In this order:
 * 1. the short disclaimer every page carries (`site.disclaimerShort`). It does not replace the D5
 *    AI notice near the top of a content page (ADR 0006 is explicit that the notice must not live
 *    only in the footer), and it never says more than the sources support;
 * 2. the site map (`#st-site-map`): the six sections, the tools, and the guide's own pages
 *    (Contents, About, "How this was made and how to check it"). Below 1024px without JavaScript
 *    the header's Menu is a link here, which is what keeps that header to one row;
 * 3. the theme control (`#st-theme`), which left the top bar in WP-50 Phase 3 (it was the widest
 *    thing in it). It needs JavaScript to save a choice; without it a line says the page follows
 *    the device. From 1024px the bar's Tools menu ends with "Light or dark", a link here;
 * 4. "Back to top", `#top`, which every browser takes to the top of the document when no element
 *    has that id: it works without JavaScript, and from 1024px, where the bar is sticky, a link to
 *    the bar itself would not scroll at all.
 *
 * The links are navigation lists (`.st-quiet-links`: the underline shows on hover and focus) in the
 * text colour, which is verified on `--st-surface-2`. `aria-current="page"` marks the page the
 * reader is on, in words for a screen reader and in weight on screen.
 */
import ThemeControl from './ThemeControl.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import {
  SITE_MAP_ID,
  THEME_ID,
  footerLinks,
  isCurrent,
  sectionLinks,
  toolLinks,
  type NavLink,
} from '../../lib/nav';
import type { Manifest } from '../../lib/content/schema';

interface Props {
  locale: Locale;
  manifest: Manifest;
  route: string;
}

const { locale, manifest, route } = Astro.props;
const t = useTranslations(locale);
const groups: { id: string; label: string; links: NavLink[] }[] = [
  { id: 'st-footer-read', label: t('nav.read'), links: sectionLinks(manifest, locale, t) },
  { id: 'st-footer-tools', label: t('nav.tools'), links: toolLinks(manifest, locale, t) },
  { id: 'st-footer-guide', label: t('site.footerGuide'), links: footerLinks(manifest, locale, t) },
];
---

<footer class="st-footer">
  <div class="st-container st-footer__inner">
    <p class="st-footer__disclaimer">{t('site.disclaimerShort')}</p>
    <nav class="st-footer__map" id={SITE_MAP_ID} aria-label={t('site.footerLabel')}>
      {groups.map((group) => (
        <div class="st-footer__group" data-footer-group={group.id}>
          <h2 class="st-footer__heading" id={group.id}>
            {group.label}
          </h2>
          <ul class="st-footer__links st-quiet-links" role="list" aria-labelledby={group.id}>
            {group.links.map((link) => (
              <li>
                <a
                  class="st-link-block st-footer__link"
                  href={link.href}
                  aria-current={isCurrent(link, route) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    {/* The target of "Light or dark" (the bar's Tools menu) and of `/about/` Settings. */}
    <div class="st-footer__theme" id={THEME_ID} tabindex="-1">
      <ThemeControl locale={locale} showLegend />
    </div>
    <p class="st-footer__top">
      <a class="st-link-block st-footer__link" href="#top">
        {t('nav.backToTop')}
      </a>
    </p>
  </div>
</footer>

<style>
  .st-footer {
    border-block-start: var(--st-border-width) solid var(--st-border);
    background-color: var(--st-surface-2);
  }

  .st-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-5);
    padding-block: var(--st-space-6);
  }

  .st-footer__disclaimer {
    max-inline-size: var(--st-measure);
    color: var(--st-text);
    font-size: var(--st-text-sm);
  }

  /* One column on a phone, two from 480px, three from about 640px. */
  .st-footer__map {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--st-space-5);
  }

  .st-footer__heading {
    margin-block-end: var(--st-space-1);
    color: var(--st-text);
    font-family: var(--st-font-body);
    font-size: var(--st-text-sm);
    font-weight: var(--st-weight-bold);
    letter-spacing: normal;
    line-height: var(--st-leading-snug);
  }

  .st-footer__links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0;
    list-style: none;
  }

  .st-footer__link,
  .st-footer__link:visited {
    color: var(--st-text);
  }

  .st-footer__link[aria-current='page'] {
    font-weight: var(--st-weight-semibold);
  }

  @media (forced-colors: active) {
    .st-footer {
      border-block-start: 1px solid CanvasText;
    }
  }
</style>
