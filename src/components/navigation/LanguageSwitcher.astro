---
/**
 * The language switcher (build plan B2, B3 flow 7): a plain link to the same page in each other
 * language, named in that language ("Afrikaans" on an English page, "English" on an Afrikaans
 * one). It never redirects and never depends on JavaScript.
 *
 * Only the other languages are links. The page's own language was a second link marked
 * `aria-current`, a link to the page the reader is on; since WP-50 Phase 3, item 5 the header row
 * holds one link at every width, which is what a reader who cannot read this page looks for
 * (WP-50 directions, "Decided": the W3C internationalisation guidance and GOV.UK's Welsh link).
 *
 * `<st-lang-switch>` adds the current `#fragment` to the links once JavaScript runs, so a reader
 * who switches language halfway down a page lands on the same heading. Heading ids are English
 * slugs in every language, so the anchor is valid in both.
 */
import { splitAroundParam } from '../../lib/pages';
import { useTranslations } from '../../i18n';
import { ENABLED_LOCALES, getLocale, type Locale } from '../../i18n/locales';
import { href } from '../../lib/paths';

interface Props {
  locale: Locale;
  /** Site-relative route without the locale prefix and without the base, e.g. `core/register/`. */
  route: string;
  class?: string | undefined;
}

const { locale, route, class: className } = Astro.props;
const t = useTranslations(locale);
/*
 * The link's name is "Read this page in Afrikaans": the sentence is in the page's language and only
 * the language's own name is in the other language. So the name is built from visible and visually
 * hidden text, and `lang` sits on the name alone. An `aria-label` would replace the whole name and
 * be read in whichever single language the link carried (review WP-20 pass 3).
 */
const switchParts = splitAroundParam((language) => t('lang.switchTo', { language }));
const options = ENABLED_LOCALES.filter((code) => code !== locale).map((code) => {
  const meta = getLocale(code);
  return {
    code,
    href: href(code, route),
    name: meta?.nativeName ?? code,
    hreflang: meta?.hreflang ?? code,
  };
});
---

<st-lang-switch class:list={['st-lang', className]}>
  <nav aria-label={t('lang.switcherLabel')}>
    <ul class="st-lang__list" role="list">
      {options.map((option) => (
        <li>
          <a
            class="st-lang__link"
            href={option.href}
            hreflang={option.hreflang}
            data-locale={option.code}
          >
            <span class="st-visually-hidden">{switchParts[0]}</span>
            <span lang={option.hreflang}>{option.name}</span>
            {switchParts[1] && <span class="st-visually-hidden">{switchParts[1]}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</st-lang-switch>

<script>
  import '../../scripts/navigation';
</script>

<style>
  /* A custom element is inline by default. */
  .st-lang {
    display: block;
  }

  .st-lang__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--st-space-1);
    padding: 0;
    list-style: none;
  }

  .st-lang__link {
    display: inline-block;
    min-block-size: var(--st-target);
    padding-block: max(0px, calc((var(--st-target) - 1lh) / 2));
    padding-inline: var(--st-space-2);
    border-radius: var(--st-radius-md);
    color: var(--st-text);
    font-weight: var(--st-weight-semibold);
    overflow-wrap: anywhere;
  }

  .st-lang__link:visited {
    color: var(--st-text);
  }

  .st-lang__link:hover {
    background-color: var(--st-primary-soft);
    color: var(--st-on-primary-soft);
  }
</style>
