---
/**
 * The top bar (build plan B2): wordmark, the Read and Tools menus, search, the language switcher,
 * the theme control, and — below 1024px — the drawer button.
 *
 * How it works without JavaScript, which is the rule for every surface here:
 * - the menus are native `<details>`, so they open and close with no script;
 * - below 1024px the menus are normally hidden in favour of the drawer button, **except** when
 *   the page has no `js` class, where the same menus are shown stacked instead. So a phone with
 *   JavaScript off reaches every section and tool through the header itself, and there is no
 *   second copy of the links to keep in step;
 * - the search control is a link to `/search/`, which is a real page. With JavaScript,
 *   `<st-search>` (SearchDialog.astro) turns a plain click on it into the search dialog, and the
 *   `/` hint shows (`js-only`: without the script the key does nothing, so no hint).
 */
import pathsData from '../../data/paths.json';
import Icon from '../ui/Icon.astro';
import Kbd from '../ui/Kbd.astro';
import SearchDialog from '../search/SearchDialog.astro';
import ProgressRing from '../ui/ProgressRing.astro';
import Logo from '../illustrations/Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import NavDrawer from './NavDrawer.astro';
import NavMenu from './NavMenu.astro';
import ThemeControl from './ThemeControl.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { sectionLinks, toolLinks } from '../../lib/nav';
import { href } from '../../lib/paths';
import type { Manifest } from '../../lib/content/schema';
import { APP_ROUTES, SEARCH_AVAILABLE, WIZARD_AVAILABLE } from '../../lib/routes';

interface Props {
  locale: Locale;
  manifest: Manifest;
  /** Site-relative route of the current page, without locale prefix and base (`''` is home). */
  route: string;
}

const { locale, manifest, route } = Astro.props;
const t = useTranslations(locale);
const sections = sectionLinks(manifest, locale, t);
const tools = toolLinks(manifest, locale, t);
const homeHref = href(locale, APP_ROUTES.home);
// While search is switched off, the page's common questions are in the footer instead.
const searchHref = SEARCH_AVAILABLE ? href(locale, APP_ROUTES.search) : undefined;
const wizardHref = WIZARD_AVAILABLE ? href(locale, APP_ROUTES.wizard) : undefined;
/** WP-31: "My path: 3 of 10 steps done", shown by `<st-path-progress>` once there is a profile. */
const pathTemplate = t('nav.pathProgress', { done: '{done}', total: '{total}' });
---

<header class="st-topbar">
  <div class="st-container st-topbar__inner">
    <a
      class="st-topbar__home"
      href={homeHref}
      aria-current={route === APP_ROUTES.home ? 'page' : undefined}
    >
      <Logo />
    </a>
    <nav class="st-topbar__menus" aria-label={t('nav.mainLabel')}>
      <NavMenu label={t('nav.read')} links={sections} route={route} group="st-topbar-menu" />
      <NavMenu label={t('nav.tools')} links={tools} route={route} group="st-topbar-menu" />
    </nav>
    {searchHref && (
      <a class="st-topbar__search" href={searchHref} data-search-open>
        <Icon name="lucide:search" size="1em" />
        <span class="st-topbar__search-label">{t('nav.search')}</span>
        {/* A visual hint only: the script announces the keys as `aria-keyshortcuts`. */}
        <span class="st-topbar__kbd js-only" aria-hidden="true" data-search-key-hint>
          <Kbd>/</Kbd>
        </span>
      </a>
    )}
    {WIZARD_AVAILABLE && (
      <st-path-progress
        class="st-topbar__path js-only"
        data-template={pathTemplate}
        data-version={pathsData.hash}
        hidden
      >
        <a
          class="st-topbar__path-link"
          href={href(locale, APP_ROUTES.myPath)}
          aria-current={route === APP_ROUTES.myPath ? 'page' : undefined}
        >
          <span aria-hidden="true" class="st-topbar__path-ring">
            <ProgressRing value={0} max={1} label={t('nav.myPath')} size={28} showValue={false} />
          </span>
          <span aria-hidden="true" class="st-topbar__path-label">
            {t('nav.myPath')}
          </span>
          <span class="st-visually-hidden" data-progress-text>
            {t('nav.myPath')}
          </span>
        </a>
      </st-path-progress>
    )}
    <LanguageSwitcher class="st-topbar__lang" locale={locale} route={route} />
    <div class="st-topbar__theme">
      <ThemeControl locale={locale} />
    </div>
    <button
      type="button"
      class="st-topbar__menu-button js-only"
      data-drawer-open="st-nav-drawer"
      aria-haspopup="dialog"
    >
      <Icon name="lucide:menu" size="1.25em" />
      <span>{t('nav.menu')}</span>
    </button>
  </div>
  <NavDrawer
    id="st-nav-drawer"
    locale={locale}
    route={route}
    sections={sections}
    tools={tools}
    searchHref={searchHref}
    wizardHref={wizardHref}
  />
  {searchHref && <SearchDialog locale={locale} manifest={manifest} />}
</header>

<script>
  import '../../scripts/path-progress';
</script>

<style>
  .st-topbar__path[hidden] {
    display: none;
  }

  .st-topbar__path-link {
    display: inline-flex;
    align-items: center;
    gap: var(--st-space-2);
    min-block-size: var(--st-target);
    padding-inline: var(--st-space-2);
    border-radius: var(--st-radius-md);
    color: var(--st-text);
    font-weight: var(--st-weight-semibold);
    overflow-wrap: anywhere;
  }

  .st-topbar__path-link:visited {
    color: var(--st-text);
  }

  .st-topbar__path-ring {
    display: inline-flex;
  }

  /*
   * From 1024 to 1279px the bar is sticky and tight: with the ring and its "My path" label it
   * wrapped to two rows, 71 to 123px (review WP-31 pass 2, minor 3). There the ring stands alone
   * and the theme control drops its icons (its words stay). The link's name stays "My path: 3 of
   * 10 steps done" (the visually hidden progress text). `wizard.spec.ts` checks one row.
   */
  @media (width < 1280px) {
    .st-topbar__path-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .st-topbar__path-link {
      min-inline-size: var(--st-target);
      justify-content: center;
    }
  }

  .st-topbar {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--st-z-sticky);
    border-block-end: var(--st-border-width) solid var(--st-border);
    background-color: var(--st-surface);
  }

  .st-topbar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--st-space-2);
    min-block-size: var(--st-topbar);
    padding-block: var(--st-space-2);
  }

  .st-topbar__home {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--st-target);
    margin-inline-end: auto;
    text-decoration: none;
  }

  .st-topbar__menus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--st-space-1);
    min-inline-size: 0;
  }

  .st-topbar__search {
    display: inline-flex;
    align-items: center;
    gap: var(--st-space-2);
    min-block-size: var(--st-target);
    padding-inline: var(--st-space-3);
    border: var(--st-border-width) solid var(--st-border-strong);
    border-radius: var(--st-radius-pill);
    color: var(--st-text);
    overflow-wrap: anywhere;
  }

  /* A key hint is no use on a touch screen. */
  @media (hover: none) {
    .st-topbar__kbd {
      display: none;
    }
  }

  /*
   * From 1024 to 1365px the search control is the icon alone, still 44px, its name the visually
   * hidden word, and `/` and Ctrl+K still announced (`aria-keyshortcuts`). With "Search"/"Soek",
   * the `/` hint and "My path" the bar wrapped to two rows again up to 1365px (124px; WP-33 merged
   * with WP-31). Below 1280px, where the ring also stands alone, the gaps narrow as well: the
   * Afrikaans bar was a few pixels too wide at 1024px. `wizard.spec.ts` checks one row.
   */
  @media (1024px <= width < 1280px) {
    .st-topbar__inner {
      gap: var(--st-space-1);
    }
  }

  @media (1024px <= width < 1366px) {
    .st-topbar__search {
      position: relative;
      justify-content: center;
      min-inline-size: var(--st-target);
      padding-inline: var(--st-space-2);
    }

    .st-topbar__search-label {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .st-topbar__kbd {
      display: none;
    }
  }

  .st-topbar__search:visited {
    color: var(--st-text);
  }

  .st-topbar__menu-button {
    display: inline-flex;
    align-items: center;
    gap: var(--st-space-2);
    min-block-size: var(--st-target);
    padding-inline: var(--st-space-3);
    border: var(--st-border-width) solid var(--st-border-strong);
    border-radius: var(--st-radius-md);
    background-color: var(--st-surface);
    color: var(--st-text);
    font-weight: var(--st-weight-semibold);
    overflow-wrap: anywhere;
  }

  /*
   * Below the sidebar breakpoint the drawer takes over — unless there is no JavaScript, and then
   * the same `<details>` menus are shown stacked, so the header alone still reaches every page.
   */
  @media (width < 1024px) {
    /*
     * Not sticky on a phone: the bar wraps to two or three rows (wordmark, search and language,
     * menu) and, with JavaScript off, carries every menu stacked. Pinned, it covered up to 40% of
     * a 320px screen and every anchor target under it (review WP-20 pass 3). While it is static,
     * `trackTopbar()` publishes an offset of 0, so the scroll padding below drops with it.
     */
    .st-topbar {
      position: static;
    }

    /*
     * The theme control is wrapped in an element this component owns. As a class passed to
     * <ThemeControl> it landed on that component's element with *its* scope attribute, this scoped
     * rule never matched, and the full control stayed in the bar, 227px tall at 320px (review
     * WP-20 pass 3). The drawer has its own theme control.
     */
    .st-topbar__menus,
    .st-topbar__theme {
      display: none;
    }

    html:not(.js) .st-topbar__menus {
      display: flex;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (width >= 1024px) {
    .st-topbar__menu-button {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .st-topbar {
      border-block-end: 1px solid CanvasText;
    }
  }
</style>

<style is:global>
  /* The theme control's icons, between 1024 and 1279px (see the top bar's own styles above). */
  @media (1024px <= width < 1280px) {
    .st-topbar__theme .st-segmented__icon {
      display: none;
    }
  }

  /*
   * Anchor targets and focused elements scroll to just below the bar, whatever its real height.
   * `--st-topbar-offset` is the bar's measured height while it is sticky and 0 while it scrolls away
   * (src/scripts/navigation.ts, `trackTopbar`). Without JavaScript it is unset, and the bar is never
   * sticky then, so 0 is right. A fixed 72px was wrong whenever the bar wrapped: 123px at 1024px
   * with JavaScript, 93px without (review WP-20 pass 4).
   *
   * `--st-toc-pill-space` is the room the table of contents keeps for its "Now reading" pill below
   * 1280px (WP-30, `TableOfContents.astro`); 0 on every other page.
   *
   * This rule owns the scroll padding. `html:root` outranks the `html` rule in WP-11's `base.css`
   * (`calc(var(--st-topbar) + …)`), which therefore never applies on a page with this header.
   */
  html:root {
    scroll-padding-block-start: calc(
      var(--st-topbar-offset, 0px) + var(--st-toc-pill-space, 0px) + var(--st-space-4)
    );
  }

  /*
   * Without JavaScript the bar is never sticky: the theme control's hint and, below 1024px, every
   * menu make it two rows or more, and nothing could measure it for the padding above. This beats
   * the component's scoped `position: sticky` on specificity.
   */
  html:not(.js) .st-topbar {
    position: static;
  }
</style>
