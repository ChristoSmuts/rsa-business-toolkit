  viewBox="0 0 96 72"
  width="96"
  height="72"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect class="st-illo-fill" x="16" y="14" width="46" height="32" rx="3"></rect>
  <path d="M8 52h62l-4 8H12zM34 56h10"></path>
  <path d="M24 24h20M24 31h28M24 38h14"></path>
  <path class="st-illo-fill" d="m78 12 8 3-11 33-5 6-3-7z"></path>
  <path d="m67 47 8 3M76 18l8 3"></path>
</svg>
