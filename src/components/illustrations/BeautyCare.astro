---
/** Beauty and personal care: a comb and scissors. Decorative. */
interface Props {
  class?: string | undefined;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['st-illustration', className]}
  viewBox="0 0 96 72"
  width="96"
  height="72"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect class="st-illo-fill" x="8" y="16" width="38" height="11" rx="3"></rect>
  <path d="M13 27v17M19 27v17M25 27v17M31 27v17M37 27v17M42 27v12"></path>
  <path d="M63 46 84 12M77 46 56 12"></path>
  <circle class="st-illo-fill" cx="60" cy="54" r="7"></circle>
  <circle class="st-illo-fill" cx="80" cy="54" r="7"></circle>
  <circle class="st-illo-ink" cx="70" cy="29" r="2"></circle>
</svg>
