---
/** General ("I sell or do many things"): a row of small shapes. Decorative. */
interface Props {
  class?: string | undefined;
}
const { class: className } = Astro.props;
---

<svg
  class:list={['st-illustration', className]}
  viewBox="0 0 96 72"
  width="96"
  height="72"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <circle class="st-illo-fill" cx="16" cy="44" r="9"></circle>
  <rect class="st-illo-fill" x="32" y="35" width="18" height="18" rx="2"></rect>
  <path class="st-illo-fill" d="m66 34 10 19H56z"></path>
  <path class="st-illo-fill" d="m85 34 7 10-7 10-7-10z"></path>
  <circle class="st-illo-ink" cx="41" cy="22" r="3"></circle>
  <circle class="st-illo-ink" cx="66" cy="20" r="2"></circle>
  <path d="M4 62h88"></path>
</svg>
