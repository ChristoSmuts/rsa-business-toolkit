---
/**
 * "Go straight to" on a business type (WP-50 Phase 3, item 3): one wrapping line of links to the
 * parts of a long page a first-time owner looks for and "On this page" does not put first: how
 * long it takes, where the page says, and the checklist, which on the vehicle dealer is 30,000px
 * down a phone. Each is named by its own heading.
 *
 * Review pass 1, minor 5: the first build listed the "what you need" sections too and took 118 to
 * 162px on food, repeating the contents list just below; it is now the label and at most two links
 * on one line, a dot between them that is not read out. Each link is still a 44px target. It sits
 * after the AI notice, so it never pushes the notice off the first screen, and from 1280px, where
 * the contents column is always in view, it is not shown. Print leaves it out.
 *
 * The visible label is `aria-hidden`: it names the list (`aria-labelledby` still reads it), so a
 * screen reader hears "Go straight to:" once, as the list's name (review pass 2, minor 3).
 */
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { GlanceLink } from '../../lib/business-types';

interface Props {
  locale: Locale;
  links: readonly GlanceLink[];
  /** `lang` for the headings' words when the document is not in the page's language. */
  contentLang?: string | undefined;
}

const { locale, links, contentLang } = Astro.props;
const t = useTranslations(locale);
const labelId = 'st-type-jump-label';
---

{links.length > 0 && (
  <div class="st-type-jump st-no-print">
    <span class="st-type-jump__label" id={labelId} aria-hidden="true">
      {t('businessTypes.glance.goTo')}
    </span>
    <ul class="st-type-jump__links" role="list" aria-labelledby={labelId}>
      {links.map((link) => (
        <li>
          <a href={`#${link.id}`} data-jump={link.kind} lang={contentLang}>
            {link.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  /*
   * One line that wraps: the label, then the links with a dot between them. It sits 4px under the
   * notices, not the header's 12px: a 44px target already centres its words about 10px down.
   */
  .st-type-jump {
    display: flex;
    font-size: var(--st-text-sm);
    flex-wrap: wrap;
    gap: 0 var(--st-space-2);
    align-items: center;
    max-inline-size: var(--st-measure);
    margin-block-start: calc(var(--st-space-1) - var(--st-space-3));
  }

  .st-type-jump__label {
    color: var(--st-text-muted);
  }

  .st-type-jump__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .st-type-jump__links li {
    display: flex;
    align-items: center;
  }

  /* The dot is decoration: empty alternative text, so it is not read out. */
  .st-type-jump__links li + li::before {
    content: '·';
    content: '·' / '';
    padding-inline: var(--st-space-2);
    color: var(--st-text-muted);
  }

  .st-type-jump__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--st-target);
    overflow-wrap: break-word;
  }

  /* From 1280px the contents column is always in view and lists the same sections. */
  @media (width >= 1280px) {
    .st-type-jump {
      display: none;
    }
  }
</style>
