---
/**
 * A section landing (build plan B6; WP-50 Phase 3, direction A): breadcrumb · the shweshwe section
 * header · the section's pages to read, in order, as page rows (title, summary, read time, badges) ·
 * the section's tools as tool panels (a fillable template, the saving checklist) · the AI line.
 *
 * The list's own order is the reading order, so the rows carry no "Page 2 of 10" eyebrow. A
 * template is a tool while `TEMPLATES_FILLABLE` is on and the checklist while `CHECKLIST_SAVES` is;
 * with the flag off each is a page to read again.
 *
 * The cards are built from each document's own data, so a summary or reading time on a landing
 * is always the one the document page shows. An Afrikaans landing whose documents are not
 * translated yet marks each English summary with `lang="en"`.
 */
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Breadcrumb from '../navigation/Breadcrumb.astro';
import { formatDate, useTranslations, type TranslationKey } from '../../i18n';
import { getLocale, type Locale } from '../../i18n/locales';
import { docHref, docTitle, docTitleLang, sectionTitle } from '../../lib/content/manifest';
import type { Doc, Manifest } from '../../lib/content/schema';
import type { Crumb } from '../../lib/nav';
import { latestCheck, sectionHue } from '../../lib/pages';
import { href } from '../../lib/paths';
import { APP_ROUTES, CHECKLIST_SAVES, NAV_DOC_IDS, TEMPLATES_FILLABLE } from '../../lib/routes';

interface Props {
  locale: Locale;
  manifest: Manifest;
  sectionId: string;
  /** The section's documents in order, each in the language it is rendered in. */
  docs: readonly Doc[];
}

const { locale, manifest, sectionId, docs } = Astro.props;
const checkedOn = latestCheck(docs);
const t = useTranslations(locale);
const title = sectionTitle(manifest, sectionId, locale);
const hue = sectionHue(sectionId) ?? 'start';
const crumbs: Crumb[] = [
  { href: href(locale, APP_ROUTES.home), label: t('nav.home') },
  { href: undefined, label: title },
];
const howMadeHref = docHref(manifest, NAV_DOC_IDS.howThisWasMade, locale);
const description = t(`nav.sections.${sectionId}.description` as TranslationKey);
const isTool = (doc: Doc): boolean =>
  (doc.kind === 'template' && TEMPLATES_FILLABLE) || (doc.kind === 'checklist' && CHECKLIST_SAVES);
const pages = docs.filter((doc) => !isTool(doc));
const tools = docs.filter(isTool).map((doc) => {
  const name = docTitle(manifest, doc.id, locale);
  return doc.kind === 'template'
    ? { doc, name, action: t('templates.open'), context: name, icon: 'lucide:notebook-pen' }
    : {
        doc,
        name,
        action: t('home.whereToStart.checklist.action'),
        context: undefined,
        icon: 'lucide:list-checks',
      };
});
const contentLang = (doc: Doc): string | undefined =>
  doc.lang === locale ? undefined : (getLocale(doc.lang)?.hreflang ?? doc.lang);
---

<div class="st-container st-stack st-stack-lg st-section-page" data-section={hue}>
  <Breadcrumb crumbs={crumbs} locale={locale} />
  <SectionHeader section={hue} title={title} level={1} />
  <p class="st-lead">{description}</p>
  <p class="st-hint">{t('section.docCount', { count: docs.length })}</p>

  {pages.length > 0 && (
    <ol
      class="st-rows st-section-page__list"
      role="list"
      aria-label={t('section.pagesLabel', { section: title })}
    >
      {pages.map((doc) => (
        <li>
          <Card
            title={docTitle(manifest, doc.id, locale)}
            titleLang={docTitleLang(manifest, doc.id, locale)}
            href={docHref(manifest, doc.id, locale)}
            section={hue}
            headingLevel={2}
          >
            <p lang={contentLang(doc)}>{doc.summary}</p>
            <p slot="meta" class="st-cluster">
              <Badge variant="status" icon="lucide:clock">
                {t('doc.readTime', { minutes: doc.readingTime })}
              </Badge>
              {doc.appliesTo.entity !== 'all' && (
                <Badge variant="entity">
                  {doc.appliesTo.entity === 'pty' ? t('doc.ptyOnly') : t('doc.soleProprietorOnly')}
                </Badge>
              )}
            </p>
          </Card>
        </li>
      ))}
    </ol>
  )}

  {tools.length > 0 && (
    <section class="st-stack" aria-labelledby="st-section-tools">
      <h2 id="st-section-tools" class="st-section-page__tools-title">
        {t('section.toolsHeading')}
      </h2>
      <ul class="st-section-page__tools" role="list">
        {tools.map((tool) => (
          <li>
            <Card
              title={tool.name}
              titleLang={docTitleLang(manifest, tool.doc.id, locale)}
              href={docHref(manifest, tool.doc.id, locale)}
              section={hue}
              headingLevel={3}
              variant="tool"
              icon={tool.icon}
              action={tool.action}
              actionContext={tool.context}
            >
              <p lang={contentLang(tool.doc)}>{tool.doc.summary}</p>
            </Card>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="st-hint">
    {checkedOn && t('site.checkedOn', { date: formatDate(locale, checkedOn) })}{' '}
    {howMadeHref && <a href={howMadeHref}>{t('trust.aiNotice.link')}</a>}
  </p>
</div>

<style>
  .st-section-page {
    padding-block: var(--st-space-5) var(--st-space-8);
  }

  .st-section-page__list {
    max-inline-size: var(--st-measure);
  }

  /* The tools' heading is a sans label, not a reading title: these are things to use. */
  .st-section-page__tools-title {
    font-family: var(--st-font-body);
    font-size: var(--st-text-lg);
    letter-spacing: 0;
  }

  .st-section-page__tools {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--st-space-4);
    padding: 0;
    list-style: none;
  }
</style>
