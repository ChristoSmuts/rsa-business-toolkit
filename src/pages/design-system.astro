---
/**
 * /design-system/ — live Stoep reference (noindex; excluded from the sitemap in astro.config).
 * Static token values come from tokens.css at build time; the contrast panel re-measures the
 * computed colours in the browser so drift shows as FAIL.
 */
import Base from '../layouts/Base.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Callout from '../components/ui/Callout.astro';
import Card from '../components/ui/Card.astro';
import EffortMeter from '../components/ui/EffortMeter.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Icon from '../components/ui/Icon.astro';
import Kbd from '../components/ui/Kbd.astro';
import ProgressRing from '../components/ui/ProgressRing.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import TableScroll from '../components/ui/TableScroll.astro';
import ToastRegion from '../components/ui/ToastRegion.astro';
import VisuallyHidden from '../components/ui/VisuallyHidden.astro';
import Logo from '../components/illustrations/Logo.astro';
import VehicleDealer from '../components/illustrations/VehicleDealer.astro';
import FoodBusiness from '../components/illustrations/FoodBusiness.astro';
import BeautyCare from '../components/illustrations/BeautyCare.astro';
import RetailOnline from '../components/illustrations/RetailOnline.astro';
import ServicesTrades from '../components/illustrations/ServicesTrades.astro';
import ProfessionalCreative from '../components/illustrations/ProfessionalCreative.astro';
import General from '../components/illustrations/General.astro';
import tokensSource from '../styles/tokens.css?raw';
import {
  CONTRAST_PAIRS,
  contrastRatio,
  darkTheme,
  formatRatio,
  parseTokenBlocks,
  resolveColor,
  toHex,
} from '../scripts/color';
import { href } from '../lib/paths';

const blocks = parseTokenBlocks(tokensSource);
const light = blocks.light;
const dark = darkTheme(blocks);

const swatchGroups: { title: string; tokens: string[] }[] = [
  {
    title: 'Surfaces and borders',
    tokens: ['bg', 'surface', 'surface-2', 'border', 'border-strong'],
  },
  {
    title: 'Text, links and focus',
    tokens: ['text', 'text-muted', 'link', 'link-hover', 'link-visited', 'focus'],
  },
  {
    title: 'Primary (veld green)',
    tokens: ['primary', 'primary-hover', 'on-primary', 'primary-soft', 'on-primary-soft'],
  },
  {
    title: 'Accent (rooibos)',
    tokens: ['accent', 'accent-text', 'on-accent', 'accent-soft', 'on-accent-soft'],
  },
  {
    title: 'Status',
    tokens: [
      'success-bg',
      'success-text',
      'warning-bg',
      'warning-text',
      'danger-bg',
      'danger-text',
      'info-bg',
      'info-text',
      'danger-solid',
      'on-danger-solid',
      'mark-bg',
    ],
  },
  {
    title: 'Section hues',
    tokens: ['hue-start', 'hue-core', 'hue-branding', 'hue-paperwork', 'hue-types', 'hue-lookup'],
  },
  {
    title: 'Section tints (hue over the page background, per-hue strength)',
    tokens: [
      'hue-start-tint',
      'hue-core-tint',
      'hue-branding-tint',
      'hue-paperwork-tint',
      'hue-types-tint',
      'hue-lookup-tint',
    ],
  },
];

const ratio = (fg: string, bg: string, theme: Record<string, string>) =>
  formatRatio(contrastRatio(resolveColor(fg, theme), resolveColor(bg, theme)));

const spacing = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => ({
  name: `space-${n}`,
  value: light[`space-${n}`] ?? '',
}));
const radii = ['radius-sm', 'radius-md', 'radius-lg', 'radius-pill'];
const motion = ['duration-fast', 'duration-base', 'duration-slow', 'ease'];
const layout = [
  'target',
  'target-lg',
  'container',
  'sidebar',
  'toc',
  'topbar',
  'measure',
  'measure-wide',
  'z-sticky',
  'z-drawer',
  'z-dialog',
  'z-toast',
];
const typeScale = [
  ['text-display', 'Display numbers and hero'],
  ['text-3xl', 'h1'],
  ['text-2xl', 'h2'],
  ['text-xl', 'h3'],
  ['text-lg', 'Lead, plain-words callouts'],
  ['text-md', 'Body'],
  ['text-sm', 'Meta, badges, hints'],
] as const;

const sections = [
  { id: 'start', title: 'Start here' },
  { id: 'core', title: 'Core: applies to everyone' },
  { id: 'branding', title: 'Branding and marketing' },
  { id: 'paperwork', title: 'Paperwork and templates' },
  { id: 'types', title: 'Your kind of business' },
  { id: 'lookup', title: 'Look it up' },
] as const;

// Business-type art always belongs to "Your kind of business".
const illustrations = [
  { title: 'Vehicle dealer', Component: VehicleDealer },
  { title: 'Food business', Component: FoodBusiness },
  { title: 'Beauty and personal care', Component: BeautyCare },
  { title: 'Retail and online shop', Component: RetailOnline },
  { title: 'Services and trades', Component: ServicesTrades },
  { title: 'Professional and creative', Component: ProfessionalCreative },
  { title: 'General', Component: General },
] as const;

const diacritics = 'Kôsê, sê, môre, ëïü, ḓ ṱ ṋ ṅ';
// No-break spaces keep the rand amount on one line.
const displayFigure = 'R 1 234.56';
const toc = [
  ['theme', 'Theme'],
  ['colour', 'Colour'],
  ['contrast', 'Contrast'],
  ['typography', 'Typography'],
  ['tokens', 'Spacing, radius, shadow, motion'],
  ['components', 'Components'],
  ['long-labels', 'Long labels'],
  ['notices', 'Notices and sources'],
  ['forms', 'Form controls'],
  ['illustrations', 'Illustrations'],
] as const;

/*
 * Real Afrikaans strings, for the long-label and D5 demos. The `trust.*` ones are the
 * WP-12b dictionary values (branch wp/wp12b-i18n-followup, src/i18n/af.json); the rest are
 * headings from the toolkit's own Afrikaans markdown. Afrikaans runs far past the +25%
 * i18n budget on status labels, so these are what components must survive at 320px.
 */
const af = {
  mtBadge: 'Masjienvertaling, nog nie nagegaan nie',
  aiChecked: 'KI-nagegaan (Engelse teks)',
  humanChecked: 'Engelse teks deur {reviewer} nagegaan',
  notConfirmed: 'Nie bevestig nie',
  officialSource: 'Amptelike bron',
  compound: 'Kernverpligtinge vir alle eenpersoonsondernemings',
  cardTitle: 'Registreer jou besigheid by CIPC en by SARS',
  buttonLabel: 'Vind my pad deur die registrasieproses',
  warningLabel: 'Laat indienings lei tot boetes en rente wat vinnig oploop',
  effortLabel: 'Moeite om te begin',
  tableHeading: 'Hoofrede waarom hierdie stap nodig is',
};

const afEffortLabels = [
  'Laagste',
  'Laag tot middelmatig',
  'Middelmatig',
  'Middelmatig tot hoog',
  'Hoog',
] as const;

/*
 * D5 demo copy: the English and Afrikaans `trust.*` strings.
 * `{reviewer}` stays a placeholder on purpose. D5 reserves a named human reviewer for a real
 * one, and a screenshot of this page would otherwise read as a claim that a person checked it.
 * The date is the date the toolkit's own register was last checked
 * (docs/rsa-business-toolkit/05 Look it up/03-sources-and-verification-register.md), so the
 * demo never states a verification date the project cannot stand behind.
 */
const checkedDate = '13 September 2026';
const trust = {
  en: {
    label: 'About this page',
    body: `Written by AI (Claude, Anthropic). An AI checked it against the sources below on ${checkedDate}. No person has checked it yet. Rules change: check the official source before you act. Not legal, tax or financial advice.`,
    bodyHuman: `Written by AI (Claude, Anthropic). {reviewer} checked it against the sources below on ${checkedDate}. Rules change: check the official source before you act. Not legal, tax or financial advice.`,
    status: 'AI-checked',
    statusHuman: 'Checked by {reviewer}',
    means: 'An AI compared the facts on this page with the sources. An AI can miss mistakes.',
    meansHuman:
      '{reviewer} checked the facts on this page against the sources. Mistakes are still possible, and rules can change after that date.',
    link: 'How this was made',
  },
  af: {
    label: 'Oor hierdie bladsy',
    body: `Deur KI geskryf (Claude, Anthropic). ’n KI het die Engelse teks op ${checkedDate} teen die bronne hieronder nagegaan. Geen mens het dit nog nagegaan nie. Reëls verander: kontroleer die amptelike bron voordat jy iets doen. Dit is nie regs-, belasting- of finansiële advies nie.`,
    status: af.aiChecked,
    means:
      '’n KI het die feite in die Engelse teks met die bronne vergelyk. ’n KI kan foute oorsien.',
    link: 'Hoe dit gemaak is',
  },
};
---

<Base
  lang="en"
  title="Stoep design system · SA Business Toolkit"
  description="Live reference for the Stoep design system: tokens, contrast, type and components."
  noindex
>
  <header slot="header" class="ds-topbar">
    <div class="st-container ds-topbar__inner">
      <a class="ds-topbar__home" href={href('en')}>
        <Logo />
      </a>
      <span class="ds-topbar__tag">Design system</span>
    </div>
  </header>

  <div class="st-container ds-page">
    <SectionHeader section="start" title="Stoep design system" eyebrow="Reference">
      <p>
        Plain first. Warm, not corporate. Colour never carries meaning alone. Fast on a cheap phone.
        One source of truth: <code>src/styles/tokens.css</code>.
      </p>
    </SectionHeader>

    <nav class="ds-toc" aria-label="On this page">
      <ul class="st-cluster" role="list">
        {toc.map(([id, label]) => (
          <li>
            <a href={`#${id}`}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="ds-section">
      <h2 id="theme">Theme</h2>
      <st-theme-toggle class="js-only">
        <fieldset class="ds-theme">
          <legend>Colour theme</legend>
          <div class="ds-segmented">
            {(
              [
                ['system', 'System', 'lucide:monitor'],
                ['light', 'Light', 'lucide:sun'],
                ['dark', 'Dark', 'lucide:moon'],
              ] as const
            ).map(([value, text, icon]) => (
              <label class="ds-segmented__option">
                <input type="radio" name="st-theme" value={value} checked={value === 'system'} />
                <span class="ds-segmented__icon">
                  <Icon name={icon} />
                </span>
                <span>{text}</span>
                <span class="ds-segmented__tick">
                  <Icon name="lucide:check" />
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      </st-theme-toggle>
      <p class="no-js-only st-hint">
        The theme control needs JavaScript. Without it the page follows your device setting.
      </p>
      <p class="st-hint">
        Saved on this device only, as <code>st.theme</code>.
      </p>
    </section>

    <section class="ds-section">
      <h2 id="colour">Colour</h2>
      <p class="ds-intro">
        Every colour is a <code>--st-</code> custom property. Light and dark values below are read
        from <code>tokens.css</code> at build time; “Now” is measured in your browser.
      </p>
      {swatchGroups.map((group) => (
        <div class="ds-swatch-group">
          <h3>{group.title}</h3>
          <ul class="ds-swatches" role="list">
            {group.tokens.map((token) => (
              <li class="ds-swatch" data-swatch-token={token}>
                <span class="ds-swatch__chip" style={`background-color: var(--st-${token})`} />
                <span class="ds-swatch__meta">
                  <code class="ds-swatch__name">--st-{token}</code>
                  <span class="ds-swatch__values">
                    Light {toHex(resolveColor(token, light))} · Dark{' '}
                    {toHex(resolveColor(token, dark))}
                  </span>
                  <span class="ds-swatch__values js-only">
                    Now <span data-swatch-value>…</span>
                  </span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="ds-section">
      <h2 id="contrast">Contrast</h2>
      <p class="ds-intro">
        WCAG 2.x ratios. Text needs at least 4.5:1; control borders and focus rings at least 3:1.
        Ratios are truncated, never rounded up.
      </p>
      <p class="ds-contrast-summary" data-contrast-summary aria-live="polite">
        <span class="js-only">Measuring…</span>
        <span class="no-js-only">Live checks need JavaScript; build-time ratios are shown.</span>
      </p>
      <TableScroll labelledby="contrast-caption">
        <table class="ds-contrast">
          <caption id="contrast-caption">Verified colour pairs</caption>
          <thead>
            <tr>
              <th scope="col">Pair</th>
              <th scope="col">Sample</th>
              <th scope="col">Use</th>
              <th scope="col" class="st-num">
                Needs
              </th>
              <th scope="col" class="st-num">
                Light
              </th>
              <th scope="col" class="st-num">
                Dark
              </th>
              <th scope="col" class="st-num">
                Now
              </th>
              <th scope="col">Result</th>
            </tr>
          </thead>
          <tbody>
            {CONTRAST_PAIRS.map((pair) => (
              <tr
                data-contrast-fg={pair.fg}
                data-contrast-bg={pair.bg}
                data-contrast-min={pair.min}
              >
                <th scope="row" data-label="Pair">
                  <code>{pair.fg}</code> on <code>{pair.bg}</code>
                </th>
                <td data-label="Sample">
                  {pair.min === 4.5 ? (
                    <span
                      class="ds-sample"
                      style={`color: var(--st-${pair.fg}); background-color: var(--st-${pair.bg})`}
                    >
                      Aa
                    </span>
                  ) : (
                    <span class="ds-sample" style={`background-color: var(--st-${pair.bg})`}>
                      <span class="ds-sample__ui" style={`border-color: var(--st-${pair.fg})`} />
                    </span>
                  )}
                </td>
                <td data-label="Use">{pair.use}</td>
                <td data-label="Needs" class="st-num">
                  {pair.min}:1
                </td>
                <td data-label="Light" class="st-num">
                  {ratio(pair.fg, pair.bg, light)}
                </td>
                <td data-label="Dark" class="st-num">
                  {ratio(pair.fg, pair.bg, dark)}
                </td>
                <td data-label="Now" class="st-num" data-contrast-ratio>
                  –
                </td>
                <td data-label="Result">
                  <span class="ds-result" data-contrast-result data-result="pending">
                    Not checked
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </TableScroll>
    </section>

    <section class="ds-section">
      <h2 id="typography">Typography</h2>
      <p class="ds-intro">
        Headings: Fraunces (variable, weight 600, optical size 48; 144 for display). Body and UI:
        Instrument Sans (variable). Code: system monospace. Self-hosted latin and latin-ext subsets.
      </p>
      <div class="ds-type">
        <p class="st-display">{displayFigure}</p>
        <p class="ds-type__h1">Register your business</p>
        <p class="ds-type__h2">Tax and SARS</p>
        <p class="ds-type__h3">What you need to sell things</p>
        <p class="st-lead">
          Lead text introduces a page in one or two sentences, in the reader’s own words.
        </p>
        <p>
          Body text is set at 16 to 18 pixels with a line height of 1.6 and a measure of about 68
          characters, so long guides stay comfortable on a phone and on a desktop.
        </p>
        <p>
          <small>Small text for meta information such as “8 min read”.</small>
        </p>
        <p>
          <code>const total = subtotal + vat;</code>
        </p>
      </div>
      <h3>Diacritics</h3>
      <dl class="ds-diacritics">
        <dt>Fraunces</dt>
        <dd class="ds-diacritics__display" lang="af">
          {diacritics}
        </dd>
        <dt>Instrument Sans</dt>
        <dd class="ds-diacritics__body" lang="af">
          {diacritics}
        </dd>
        <dt>Instrument Sans bold</dt>
        <dd class="ds-diacritics__bold" lang="af">
          {diacritics}
        </dd>
        <dt>Monospace</dt>
        <dd class="ds-diacritics__mono" lang="af">
          {diacritics}
        </dd>
      </dl>
      <TableScroll labelledby="type-caption">
        <table>
          <caption id="type-caption">Fluid type scale (320px to 1280px viewport)</caption>
          <thead>
            <tr>
              <th scope="col">Token</th>
              <th scope="col">Value</th>
              <th scope="col">Use</th>
            </tr>
          </thead>
          <tbody>
            {typeScale.map(([token, use]) => (
              <tr>
                <th scope="row">
                  <code>--st-{token}</code>
                </th>
                <td>
                  <code>{light[token]}</code>
                </td>
                <td>{use}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </TableScroll>
    </section>

    <section class="ds-section">
      <h2 id="tokens">Spacing, radius, shadow, motion</h2>
      <h3>Spacing</h3>
      <ul class="ds-spacing" role="list">
        {spacing.map((s) => (
          <li>
            <code>--st-{s.name}</code>
            <span class="ds-spacing__value">{s.value}</span>
            <span class="ds-spacing__bar" style={`inline-size: var(--st-${s.name})`} />
          </li>
        ))}
      </ul>
      <h3>Radius</h3>
      <ul class="ds-tiles" role="list">
        {radii.map((r) => (
          <li class="ds-tile" style={`border-radius: var(--st-${r})`}>
            <code>--st-{r}</code>
            <span>{light[r]}</span>
          </li>
        ))}
      </ul>
      <h3>Shadow</h3>
      <ul class="ds-tiles" role="list">
        <li class="ds-tile" style="box-shadow: var(--st-shadow-1)">
          <code>--st-shadow-1</code>
        </li>
        <li class="ds-tile" style="box-shadow: var(--st-shadow-2)">
          <code>--st-shadow-2</code>
        </li>
      </ul>
      <h3>Motion, layers and layout</h3>
      <TableScroll labelledby="layout-caption">
        <table>
          <caption id="layout-caption">Motion, z-index and layout tokens</caption>
          <thead>
            <tr>
              <th scope="col">Token</th>
              <th scope="col">Value</th>
            </tr>
          </thead>
          <tbody>
            {[...motion, ...layout].map((token) => (
              <tr>
                <th scope="row">
                  <code>--st-{token}</code>
                </th>
                <td>
                  <code>{light[token]}</code>
                </td>
              </tr>
            ))}
            <tr>
              <th scope="row">Breakpoints</th>
              <td>sm 480px · md 768px · lg 1024px (sidebar) · xl 1280px (TOC)</td>
            </tr>
          </tbody>
        </table>
      </TableScroll>
      <p class="st-hint">
        With reduced motion, all durations collapse to 0ms and hover lifts are removed.
      </p>
    </section>

    <section class="ds-section">
      <h2 id="components">Components</h2>

      <h3>Button</h3>
      <div class="ds-demo">
        {(['primary', 'secondary', 'ghost', 'danger'] as const).map((variant) => (
          <div class="st-cluster">
            <Button variant={variant}>{variant.charAt(0).toUpperCase() + variant.slice(1)}</Button>
            <Button variant={variant} iconStart="lucide:download">
              With icon
            </Button>
            <Button variant={variant} loading loadingText="Saving">
              Saving
            </Button>
            <Button variant={variant} disabled>
              Disabled
            </Button>
          </div>
        ))}
        <div class="st-cluster">
          <Button size="lg" iconEnd="lucide:arrow-right">
            Find my path
          </Button>
          <Button size="lg" variant="secondary" href={href('en')}>
            Link as button
          </Button>
          <Button variant="ghost" iconStart="lucide:printer">
            Print
          </Button>
        </div>
        <p class="st-hint">
          Tab through the buttons to see the 2px rooibos focus ring. Loading keeps the button colour
          and shows a spinner; disabled is dashed and muted. Both stay focusable, use
          <code>aria-disabled</code> and ignore clicks.
        </p>
      </div>

      <h3>Card</h3>
      <div class="st-grid ds-demo">
        <Card
          title="Register your business"
          href={href('en')}
          section="core"
          eyebrow="Core · 2"
          headingLevel={4}
        >
          <p>Choose between sole proprietor and Pty Ltd, then register with CIPC and SARS.</p>
          <Fragment slot="meta">
            <span>8 min read</span>
            <Badge variant="entity">Everyone</Badge>
          </Fragment>
        </Card>
        <Card title="Food business" href={href('en')} section="types" headingLevel={4}>
          <FoodBusiness slot="illustration" />
          <p>Certificate of Acceptability, training and inspections.</p>
          <Fragment slot="meta">
            <EffortMeter level={5} />
          </Fragment>
        </Card>
        <Card title="Static card (no link)" section="lookup" headingLevel={4}>
          <p>
            Cards without <code>href</code> have no tab stop and no hover lift.
          </p>
        </Card>
      </div>

      <h3>Callout</h3>
      <div class="st-stack ds-demo">
        <Callout variant="plain-words">
          <p>You and the business are the same person for tax. Its income is your income.</p>
        </Callout>
        <Callout variant="note">
          <p>Keep every invoice for five years.</p>
        </Callout>
        <Callout variant="warning">
          <p>Late submissions attract penalties and interest.</p>
        </Callout>
        <Callout variant="official">
          <p>Check the current threshold on the SARS website.</p>
        </Callout>
        <Callout variant="info">
          <p>You can change your answers at any time.</p>
        </Callout>
      </div>

      <h3>Badge</h3>
      <div class="st-cluster ds-demo">
        <Badge variant="entity">Pty Ltd only</Badge>
        <Badge variant="type">Food</Badge>
        <Badge variant="official">Official</Badge>
        <Badge variant="status" icon="lucide:bot">
          AI-checked
        </Badge>
        <Badge variant="effort">Effort: medium</Badge>
        <Badge variant="mt">Machine translated</Badge>
        <Badge variant="flag">Not confirmed</Badge>
        <Badge variant="entity" icon={null}>
          Text only
        </Badge>
      </div>
      <p class="st-hint">
        Badges wrap. A label longer than the row it sits in breaks onto a second or third line and
        keeps its shape; it never widens the page. See <a href="#long-labels">Long labels</a>.
      </p>

      <h3>Effort meter</h3>
      <ul class="st-stack st-stack-sm ds-demo" role="list" data-section="types">
        {([1, 2, 3, 4, 5] as const).map((level) => (
          <li>
            <EffortMeter level={level} />
          </li>
        ))}
      </ul>

      <h3>Progress ring</h3>
      <div class="st-cluster ds-demo">
        <ProgressRing value={0} max={34} label="Part A: 0 of 34 done" />
        <ProgressRing value={12} max={34} label="Part A: 12 of 34 done" />
        <ProgressRing value={34} max={34} label="Part A: 34 of 34 done" />
        <ProgressRing value={3} max={4} size={36} showValue={false} label="3 of 4 steps done" />
      </div>

      <h3>Section header</h3>
      <div class="st-stack ds-demo">
        {sections.map((s) => (
          <SectionHeader section={s.id} title={s.title} level={4} eyebrow="Section">
            <p>Hue stripe, soft tint and a shweshwe-inspired dot pattern.</p>
          </SectionHeader>
        ))}
      </div>

      <h3>Empty state</h3>
      <div class="ds-demo">
        <EmptyState title="No results for “zzz”" icon="lucide:search" headingLevel={4}>
          <p>Try a shorter word, or browse the full contents.</p>
          <Fragment slot="actions">
            <Button variant="secondary" href={href('en')}>
              Browse contents
            </Button>
          </Fragment>
        </EmptyState>
      </div>

      <h3>Toast</h3>
      <div class="ds-demo">
