<style>
  .ds-topbar {
    border-block-end: var(--st-border-width) solid var(--st-border);
    background-color: var(--st-surface);
  }

  .ds-topbar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--st-space-3);
    min-block-size: var(--st-topbar);
  }

  .ds-topbar__home {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--st-target);
    color: var(--st-text);
    text-decoration: none;
  }

  .ds-topbar__home:visited {
    color: var(--st-text);
  }

  .ds-topbar__home:hover {
    text-decoration: underline;
  }

  .ds-topbar__tag {
    color: var(--st-text-muted);
    font-size: var(--st-text-sm);
    font-weight: var(--st-weight-semibold);
  }

  /*
   * `minmax(0, 1fr)`, not the implicit `auto` track: an implicit track sizes to its children's
   * min-content, so one unbreakable Afrikaans compound in a heading would widen the whole page
   * at 320px. Page packages copy this layout, so both grids state the cap.
   */
  .ds-page {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-8);
    padding-block: var(--st-space-6) var(--st-space-9);
  }

  .ds-toc ul {
    padding: 0;
    list-style: none;

    --st-cluster-gap: var(--st-space-1) var(--st-space-4);
  }

  .ds-toc a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--st-target);
  }

  .ds-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-5);
    min-inline-size: 0;
  }

  .ds-section > h3 {
    margin-block-start: var(--st-space-5);
  }

  .ds-intro {
    max-inline-size: var(--st-measure);
  }

  .ds-intro code {
    white-space: nowrap;
  }

  .ds-demo {
    padding: var(--st-space-5);
    border: var(--st-border-width) solid var(--st-border);
    border-radius: var(--st-radius-lg);
    background-color: var(--st-bg);
    gap: var(--st-space-4);
  }

  @media (width < 480px) {
    .ds-demo {
      padding: var(--st-space-3);
    }
  }

  /*
   * Every single-column grid on this page states `minmax(0, 1fr)`, not only the two outer
   * ones: an implicit `auto` track sizes to its children's min-content, so one unbreakable
   * Afrikaans compound in a type specimen widened the page to 485px at 320px. Page packages
   * copy this page, so the cap has to be visible everywhere it is needed.
   */
  div.ds-demo:not(.st-grid, .st-cluster, .st-stack) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  ul.ds-demo {
    padding-inline: var(--st-space-5);
    list-style: none;
  }

  /* Theme control */
  .ds-theme {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-2);
  }

  /* Equal-width segments on one row at every width (320px included). */
  .ds-segmented {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    max-inline-size: 30rem;
    padding: var(--st-space-1);
    border: var(--st-border-width) solid var(--st-border-strong);
    border-radius: var(--st-radius-md);
    background-color: var(--st-surface);
    gap: var(--st-space-1);
  }

  .ds-segmented__option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--st-space-2);

    /* The label is a flex item, so `min-inline-size: 0` lets it shrink but leaves its
       min-content contribution — and the segment's — at the width of its longest word. */
    min-inline-size: 0;
    overflow-wrap: anywhere;
    min-block-size: var(--st-target);
    padding-inline: var(--st-space-3);
    border: 2px solid transparent;
    border-radius: calc(var(--st-radius-md) - 2px);
    color: var(--st-text);
    font-weight: var(--st-weight-semibold);
    cursor: pointer;
