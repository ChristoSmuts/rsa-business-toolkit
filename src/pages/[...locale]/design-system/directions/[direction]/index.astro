---
/**
 * WP-50 Phase 1 mock (TEMPORARY): the home page in direction A or B, in every enabled language.
 * `noindex`, and excluded from the sitemap by the `/design-system/` filter in `astro.config.ts`.
 * See docs/work-packages/WP-50-directions.md.
 */
import MockHome from '../../../../../components/directions/MockHome.astro';
import MockShell from '../../../../../components/directions/MockShell.astro';
import { DIRECTIONS, type Direction } from '../../../../../components/directions/mock';
import { useTranslations } from '../../../../../i18n';
import type { Locale } from '../../../../../i18n/locales';
import { loadManifest } from '../../../../../lib/content/collections';
import { localeStaticPaths } from '../../../../../lib/i18n-routes';

export function getStaticPaths() {
  return localeStaticPaths().flatMap((entry) =>
    DIRECTIONS.map((direction) => ({
      params: { ...entry.params, direction },
      props: { ...entry.props, direction },
    })),
  );
}

interface Props {
  locale: Locale;
  direction: Direction;
}

const { locale, direction } = Astro.props;
const t = useTranslations(locale);
const manifest = await loadManifest();
---

<MockShell
  direction={direction}
  locale={locale}
  manifest={manifest}
  page="home"
  title={`${t('site.name')}: ${t('site.tagline')}`}
>
  <MockHome direction={direction} locale={locale} />
</MockShell>
