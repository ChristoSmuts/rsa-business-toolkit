---
/**
 * Home, in every enabled language (build plan B6; WP-50 Phase 3, direction A): hero with the AI
 * line and the stoep (Find my path's three questions under the logo's roof, decision D4 = A1) ·
 * where to start (two pages to read and one tool) · your kind of business · four things that
 * matter early · three numbers that changed in 2026, each with its date and official source (D5) ·
 * trust list. Each item uses the card set's shape for what it is: page row, tool, type tile, fact.
 *
 * With answers saved on the device, the "Your path" card (WP-31, `YourPathCard.astro`) shows above
 * the hero; everything else is what every visitor sees, and works without JavaScript.
 */
import pathsData from '../../data/paths.json';
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import BusinessTypeTiles from '../../components/pages/BusinessTypeTiles.astro';
import Icon from '../../components/ui/Icon.astro';
import LangBanner from '../../components/interactive/LangBanner.astro';
import YourPathCard from '../../components/wizard/YourPathCard.astro';
import { formatDate, useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { loadManifest, loadSources } from '../../lib/content/collections';
import { docHref, sectionHref } from '../../lib/content/manifest';
import { HOME_FOUR_THINGS, HOME_NUMBERS_YEAR, resolveHomeNumbers } from '../../lib/home';
import { localeStaticPaths } from '../../lib/i18n-routes';
import { docContentLang, latestCheck } from '../../lib/pages';
import { href } from '../../lib/paths';
import {
  APP_ROUTES,
  CHECKLIST_SAVES,
  NAV_DOC_IDS,
  SEARCH_AVAILABLE,
  WIZARD_AVAILABLE,
} from '../../lib/routes';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const manifest = await loadManifest();
const sources = await loadSources(docContentLang(manifest, NAV_DOC_IDS.sources, locale));
if (!sources) throw new Error('The sources register is missing. Run `pnpm content:build`.');
/** The figures' own source check: the register's date. */
const registerCheckedOn = formatDate(locale, sources.checkedOn);
/** The whole guide: the most recent check of any page ("most recently on"). */
const allDocs = (await getCollection('docs', (entry) => entry.data.lang === 'en')).map(
  (entry) => entry.data,
);
const checkedOn = formatDate(locale, latestCheck(allDocs) ?? sources.checkedOn);
const numbers = resolveHomeNumbers(sources);

const howMadeHref = docHref(manifest, NAV_DOC_IDS.howThisWasMade, locale);
const coreStartHref = docHref(manifest, 'core/start-here', locale);
const coreHref = sectionHref(manifest, 'core', locale);
const checklistHref = docHref(manifest, NAV_DOC_IDS.checklist, locale);
const typesHref = sectionHref(manifest, 'business-types', locale);
const wizardHref = href(locale, APP_ROUTES.wizard);
const wizardSteps = [t('wizard.steps.entity'), t('wizard.steps.types'), t('wizard.steps.stage')];

const businessTypes = (await getCollection('businessTypes')).map((entry) => entry.data);

/** Pages to read first, as page rows; the checklist beside them is a tool. */
const readFirst = [
  {
    title: t('home.whereToStart.fiveMinutes.title', { minutes: 5 }),
    body: t('home.whereToStart.fiveMinutes.body'),
    href: coreStartHref,
  },
  {
    title: t('home.whereToStart.anHour.title'),
    body: t('home.whereToStart.anHour.body'),
    href: coreHref,
  },
];
---

<Page
  locale={locale}
  manifest={manifest}
  route={APP_ROUTES.home}
  title={`${t('site.name')}: ${t('site.tagline')}`}
  description={t('site.description')}
>
  <div class="st-container st-stack st-home">
    <LangBanner locale={locale} />
    {WIZARD_AVAILABLE && <YourPathCard locale={locale} version={pathsData.hash} />}
    <section class="st-home__hero" aria-labelledby="home-title">
      <div class="st-home__hero-text st-stack">
        <h1 id="home-title">{t('home.heroTitle')}</h1>
        <p class="st-lead">{t(WIZARD_AVAILABLE ? 'home.heroLead' : 'home.heroLeadStatic')}</p>
        <p class="st-cluster">
          {WIZARD_AVAILABLE && (
            <Button href={wizardHref} variant="primary" size="lg">
              {t('home.findMyPath')}
            </Button>
          )}
          {!WIZARD_AVAILABLE && coreStartHref && (
            <Button href={coreStartHref} variant="primary" size="lg">
              {t('home.whereToStart.fiveMinutes.action')}
            </Button>
          )}
          {SEARCH_AVAILABLE ? (
            // "I know what I need" (B3 flow 1) opens the search dialog; without JavaScript it is
            // the link to the search page it always was.
            <Button
              href={href(locale, APP_ROUTES.search)}
              variant="secondary"
              size="lg"
              data-search-open
            >
              {t('home.knowWhatINeed')}
            </Button>
          ) : (
            <Button href={href(locale, APP_ROUTES.contents)} variant="secondary" size="lg">
              {t('search.browseContents')}
            </Button>
          )}
        </p>
        <p class="st-home__ai-line">
          <Icon name="lucide:bot" size="1.15em" />
          <span>
            {t('home.heroVerify', { date: checkedOn })}{' '}
            {howMadeHref && <a href={howMadeHref}>{t('home.trust.howThisWasMade')}</a>}
          </span>
        </p>
      </div>
      {WIZARD_AVAILABLE && (
        // The stoep (WP-50, decision D4 = A1): Find my path's three questions as three steps
        // widening downward under the logo's roof. The roof is drawn; the steps are text. The
        // caption is the link into the wizard and its target covers the figure.
        <figure class="st-stoep" aria-labelledby="home-stoep-caption">
          <svg
            class="st-stoep__roof"
            viewBox="0 0 200 24"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M4 21 100 3l96 18"
              fill="none"
              stroke="currentColor"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <ol class="st-stoep__steps" role="list">
            {wizardSteps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <figcaption id="home-stoep-caption" class="st-stoep__caption">
            <a class="st-stoep__link st-link-block" href={wizardHref}>
              {t('home.stoepCaption')}
            </a>
          </figcaption>
        </figure>
      )}
    </section>

    <section class="st-stack" aria-labelledby="home-where">
      <h2 id="home-where">{t('home.whereToStart.heading')}</h2>
      <div class="st-home__where">
        <ul class="st-rows" role="list" data-section="core">
          {readFirst.map((item) => (
            <li>
              <Card title={item.title} href={item.href} section="core" headingLevel={3}>
                <p>{item.body}</p>
              </Card>
            </li>
          ))}
        </ul>
        {checklistHref && (
          <Card
            title={t('home.whereToStart.checklist.title')}
            href={checklistHref}
            headingLevel={3}
            variant="tool"
            icon="lucide:list-checks"
            action={t('home.whereToStart.checklist.action')}
          >
            <p>
              {t(
                CHECKLIST_SAVES
                  ? 'home.whereToStart.checklist.body'
                  : 'home.whereToStart.checklist.bodyStatic',
              )}
            </p>
          </Card>
        )}
      </div>
    </section>

    <section class="st-stack" aria-labelledby="home-types" data-section="types">
      <h2 id="home-types">{t('home.businessTypes.heading')}</h2>
      <p>{t('home.businessTypes.lead')}</p>
      <BusinessTypeTiles locale={locale} manifest={manifest} businessTypes={businessTypes} />
      {typesHref && (
        <p>
          <a class="st-link-block" href={typesHref}>
            {t('home.businessTypes.allTypes')}
          </a>
        </p>
      )}
    </section>

    <section class="st-stack" aria-labelledby="home-four">
      <h2 id="home-four">{t('home.fourThings.heading')}</h2>
      <ul class="st-rows st-home__four" role="list" data-section="core">
        {HOME_FOUR_THINGS.map((item) => (
          <li class="st-row">
            <a class="st-link-block" href={docHref(manifest, item.doc, locale, item.anchor)}>
              {t(item.labelKey)}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="st-stack" aria-labelledby="home-numbers">
      <h2 id="home-numbers">{t('home.threeNumbers.heading', { year: HOME_NUMBERS_YEAR })}</h2>
      <p>{t('home.threeNumbers.lead')}</p>
      <ul class="st-home__facts" role="list">
        {numbers.map((item) => (
          <li class="st-home__number" data-number={item.id}>
            <h3 class="st-home__number-label">{t(item.labelKey)}</h3>
            <p class="st-home__number-value st-num">{item.amount}</p>
            {item.oldAmount && (
              <p class="st-hint">{t('home.threeNumbers.notOld', { amount: item.oldAmount })}</p>
            )}
            {item.zeroBand && (
              <p class="st-hint">
                {t('home.threeNumbers.turnoverTaxZero', {
                  rate: item.zeroBand.rate,
                  amount: item.zeroBand.amount,
                })}
              </p>
            )}
            {item.from && (
              <p class="st-hint">
                {t('home.threeNumbers.from', { date: formatDate(locale, item.from) })}
              </p>
            )}
            <p class="st-hint">{t('trust.fact.checked', { date: registerCheckedOn })}</p>
            {/* The link says "Official source"; home.test.ts guarantees every cited source is. */}
            <p>
              <a class="st-link-block" href={item.sourceUrl} rel="noopener noreferrer">
                {t('home.threeNumbers.officialSource')}
                <Icon name="lucide:external-link" size="0.9em" />
                <span class="st-visually-hidden">
                  {t('home.threeNumbers.officialSourceFor', { name: t(item.labelKey) })}
                </span>
              </a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="st-home__trust st-stack" aria-labelledby="home-trust">
      <h2 id="home-trust">{t('home.trust.label')}</h2>
      <ul class="st-home__trust-list" role="list">
        <li>
          <Icon name="lucide:bot" size="1.25em" />
          {t('home.trust.checked', { date: checkedOn })}
        </li>
        <li>
          <Icon name="lucide:book-open-check" size="1.25em" />
          {t('home.trust.sources')}
        </li>
        <li>
          <Icon name="lucide:hand-coins" size="1.25em" />
          {t('home.trust.free')}
        </li>
        {WIZARD_AVAILABLE && (
          <li>
            <Icon name="lucide:smartphone" size="1.25em" />
            {t('home.trust.private')}
          </li>
        )}
      </ul>
      {howMadeHref && (
        <p>
          <a class="st-link-block" href={howMadeHref}>
            {t('home.trust.howThisWasMade')}
          </a>
        </p>
      )}
    </section>
  </div>
</Page>

<style>
  .st-home {
    gap: var(--st-space-7);
    padding-block: var(--st-space-6) var(--st-space-8);
  }

  /* ---------- Hero: the words on the left, the stoep on the right (below on a phone) ---------- */

  .st-home__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-6);
  }

  .st-home__hero-text {
    max-inline-size: var(--st-measure);
  }

  .st-home__ai-line {
    display: flex;
    gap: var(--st-space-2);
    align-items: flex-start;
    color: var(--st-text-muted);
    font-size: var(--st-text-sm);
  }

  .st-home__ai-line .st-icon {
    flex: none;
    margin-block-start: 0.2em;
  }

  @media (width >= 1024px) {
    .st-home__hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--st-space-8);
    }
  }

  /*
   * The stoep (WP-50 D4 = A1), the page's one bold element. Three steps under the logo's roof,
   * each wider than the one above it, as in the logo. Nothing moves, on load or on hover.
   */
  .st-stoep {
    position: relative;
    display: grid;
    gap: var(--st-space-3);
    inline-size: 100%;
    max-inline-size: 34rem;
    margin: 0;
  }

  .st-stoep__roof {
    display: block;
    inline-size: 100%;
    block-size: 1.75rem;
    margin-block-end: calc(var(--st-space-1) * -1);
    color: var(--st-primary);
  }

  .st-stoep__steps {
    display: grid;
    gap: var(--st-space-1);
    padding: 0;
    list-style: none;
    counter-reset: st-stoep;
  }

  .st-stoep__steps li {
    counter-increment: st-stoep;
    display: flex;
    gap: var(--st-space-3);
    align-items: center;
    min-block-size: var(--st-target);
    padding: var(--st-space-2) var(--st-space-4);
    border-radius: var(--st-radius-sm);
    background-color: var(--st-primary-soft);
    color: var(--st-on-primary-soft);
    font-weight: var(--st-weight-semibold);
    line-height: var(--st-leading-snug);
    overflow-wrap: anywhere;
  }

  /* The question's number, in the serif of the titles; the list already numbers it for AT. */
  .st-stoep__steps li::before {
    content: counter(st-stoep);
    content: counter(st-stoep) / '';
    flex: none;
    font-family: var(--st-font-display);
    font-size: var(--st-text-xl);
    font-weight: var(--st-weight-semibold);
    line-height: 1;
  }

  .st-stoep__steps li:nth-child(1) {
    margin-inline: 14%;
  }

  .st-stoep__steps li:nth-child(2) {
    margin-inline: 7%;
  }

  .st-stoep__caption {
    color: var(--st-text-muted);
    font-size: var(--st-text-sm);
  }

  .st-stoep__link {
    color: inherit;
  }

  .st-stoep__link:visited {
    color: inherit;
  }

  /* One tab stop: the caption's link covers the figure, and the ring goes round the figure. */
  .st-stoep__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .st-stoep:has(.st-stoep__link:focus-visible) {
    outline: var(--st-focus-width) solid var(--st-focus);
    outline-offset: var(--st-space-2);
  }

  .st-stoep:has(.st-stoep__link:focus-visible) .st-stoep__link {
    outline: none;
  }

  @media (hover: hover) {
    .st-stoep:has(.st-stoep__link:hover) .st-stoep__link {
      color: var(--st-link-hover);
    }
  }

  /* ---------- Where to start: pages to read beside the one tool ---------- */

  .st-home__where {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-5);
    align-items: start;
  }

  /* From 1024px the tool stands beside the rows; at tablet width it was too narrow for its action. */
  @media (width >= 1024px) {
    .st-home__where {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--st-space-6);
    }
  }

  .st-home__four {
    max-inline-size: var(--st-measure);
  }

  .st-home__four > .st-row {
    padding-block: var(--st-space-1);
  }

  /* ---------- Three numbers: facts, each a figure with its date and source ---------- */

  .st-home__facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-5);
    padding: 0;
    list-style: none;
  }

  @media (width >= 768px) {
    .st-home__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .st-home__number {
    display: grid;
    gap: var(--st-space-1);
    align-content: start;
    padding-block-start: var(--st-space-3);
    border-block-start: 3px solid var(--st-primary);
  }

  .st-home__number-label {
    font-size: var(--st-text-md);
  }

  /* Fraunces' wght-only text cut, set like the display figures (`.st-display`): no optical size. */
  .st-home__number-value {
    font-family: var(--st-font-display);
    font-size: var(--st-text-2xl);
    font-weight: var(--st-weight-semibold);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-variant-numeric: lining-nums;
    overflow-wrap: anywhere;
  }

  /* ---------- Why you can use this guide ---------- */

  .st-home__trust {
    padding-block-start: var(--st-space-5);
    border-block-start: var(--st-border-width) solid var(--st-border);
  }

  .st-home__trust-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-3);
    padding: 0;
    list-style: none;
  }

  .st-home__trust-list li {
    display: flex;
    gap: var(--st-space-2);
    align-items: flex-start;
  }

  @media (width >= 768px) {
    .st-home__trust-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (forced-colors: active) {
    .st-stoep__steps li {
      border: 1px solid CanvasText;
    }

    .st-home__number {
      border-block-start-color: CanvasText;
    }
  }
</style>
