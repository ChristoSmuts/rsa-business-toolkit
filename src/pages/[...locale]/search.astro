---
/**
 * `/search/`: the full-page search shell (build plan B1, B3). The search client is WP-33, which
 * enhances this form in place and owns the loading, failure and "needs JavaScript" messages.
 * Until then the page says plainly that full search is not ready, the same with or without
 * JavaScript, and is still useful on its own: the common questions from "How to use this toolkit", each linked to the page
 * that answers it, and a link to the contents.
 *
 * The GET form (to this same page, so a `?q=` URL is shareable) renders once `SEARCH_AVAILABLE` is
 * true: until WP-33 a form whose submission only reloads the page would be a control that does
 * nothing.
 */
import { getEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Inline from '../../components/content/Inline.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import Callout from '../../components/ui/Callout.astro';
import { useTranslations } from '../../i18n';
import { getLocale, type Locale } from '../../i18n/locales';
import { loadManifest } from '../../lib/content/collections';
import { createContentContext } from '../../lib/content/context';
import { localeStaticPaths } from '../../lib/i18n-routes';
import { docContentLang, pageTitle } from '../../lib/pages';
import { href } from '../../lib/paths';
import { APP_ROUTES, SEARCH_AVAILABLE } from '../../lib/routes';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const manifest = await loadManifest();
const answersLang = docContentLang(manifest, 'start/how-to-use', locale);
const answers = (await getEntry('quickAnswers', answersLang))?.data;
const context = createContentContext({ locale, contentLang: answersLang, manifest });
const answersLangTag =
  answersLang === locale ? undefined : (getLocale(answersLang)?.hreflang ?? answersLang);
const contentsHref = href(locale, APP_ROUTES.contents);
---

<Page
  locale={locale}
  manifest={manifest}
  route={APP_ROUTES.search}
  title={pageTitle(t, t('search.pageTitle'))}
  description={`${t('search.label')}. ${t('site.description')}`}
>
  <div class="st-container st-stack st-stack-lg st-search">
    <Breadcrumb
      crumbs={[
        { href: href(locale, APP_ROUTES.home), label: t('nav.home') },
        { href: undefined, label: t('search.pageTitle') },
      ]}
      locale={locale}
    />
    <h1>{t('search.pageTitle')}</h1>

    {SEARCH_AVAILABLE && (
      <form
        class="st-search__form"
        action={href(locale, APP_ROUTES.search)}
        method="get"
        role="search"
      >
        <label for="st-search-q">{t('search.label')}</label>
        <div class="st-search__row">
          <input
            id="st-search-q"
            type="search"
            name="q"
            placeholder={t('search.placeholder')}
            autocomplete="off"
            enterkeyhint="search"
          />
          <Button type="submit" variant="primary">
            {t('search.button')}
          </Button>
        </div>
      </form>
    )}

    <Callout variant="info" label={t('search.dialogTitle')}>
      <p>{t('search.notReady')}</p>
      <p>
        <a class="st-link-block" href={contentsHref}>
          {t('search.browseContents')}
        </a>
      </p>
    </Callout>

    {answers && answers.items.length > 0 && (
      <section class="st-stack" aria-labelledby="search-common">
        <h2 id="search-common">{t('search.commonQuestions')}</h2>
        <ul class="st-search__answers" role="list" lang={answersLangTag}>
          {answers.items.map((item) => (
            <li class="st-search__answer">
              <p class="st-search__question">
                <Inline runs={item.question} context={context} />
              </p>
              <p>
                <Inline runs={item.targets} context={context} />
                {item.note && (
                  <Fragment>
                    {' '}
                    <Inline runs={item.note} context={context} />
                  </Fragment>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Page>

<style>
  .st-search {
    padding-block: var(--st-space-5) var(--st-space-8);
  }

  .st-search__form {
    display: grid;
    gap: var(--st-space-2);
    max-inline-size: var(--st-measure);
  }

  .st-search__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--st-space-2);
  }

  .st-search__row input {
    flex: 1 1 16rem;
    min-inline-size: 0;
  }

  .st-search__answers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-3);
    padding: 0;
    list-style: none;
    max-inline-size: var(--st-measure);
  }

  .st-search__answer {
    padding-block-end: var(--st-space-3);
    border-block-end: var(--st-border-width) solid var(--st-border);
  }

  .st-search__question {
    font-weight: var(--st-weight-semibold);
  }
</style>

<style is:global>
  /*
   * The answer links are rendered by <Inline> (a docref), so this page's scoped styles cannot reach
   * them. Each stands alone on its line, so each is a full 44px target (review WP-20 pass 5).
   */
  .st-search__answer a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--st-target);
  }
</style>
