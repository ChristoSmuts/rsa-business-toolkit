---
/**
 * `/search/?q=`: the full-page search (build plan B1, B3) and the search dialog's no-JavaScript
 * fallback.
 *
 * - With JavaScript, `<st-search-page>` (src/scripts/search-page.ts) runs `?q=` in place, echoes
 *   the query and lists the results grouped by section; a new search updates `?q=`.
 * - Without JavaScript the GET form reloads this page, which says that search needs JavaScript and
 *   answers with every page of the guide instead (the contents index), after the common questions
 *   from "How to use this toolkit".
 */
import { getEntry } from 'astro:content';
import Page from '../../layouts/Page.astro';
import Inline from '../../components/content/Inline.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import Callout from '../../components/ui/Callout.astro';
import { useTranslations } from '../../i18n';
import { getLocale, type Locale } from '../../i18n/locales';
import { loadManifest } from '../../lib/content/collections';
import { createContentContext } from '../../lib/content/context';
import { docHref, docTitle, docTitleLang, orderedSections } from '../../lib/content/manifest';
import { localeStaticPaths } from '../../lib/i18n-routes';
import { docContentLang, pageTitle } from '../../lib/pages';
import { href } from '../../lib/paths';
import { APP_ROUTES } from '../../lib/routes';
import { searchElementData } from '../../lib/search/ui-data';
import '../../styles/search.css';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const manifest = await loadManifest();
const answersLang = docContentLang(manifest, 'start/how-to-use', locale);
const answers = (await getEntry('quickAnswers', answersLang))?.data;
const context = createContentContext({ locale, contentLang: answersLang, manifest });
const answersLangTag =
  answersLang === locale ? undefined : (getLocale(answersLang)?.hreflang ?? answersLang);
const contentsHref = href(locale, APP_ROUTES.contents);
const search = searchElementData(locale, manifest);
const sections = orderedSections(manifest).map((section) => ({
  id: section.id,
  title: section.titles[locale] ?? section.titles.en ?? section.id,
  docs: section.docs.flatMap((id) => {
    const url = docHref(manifest, id, locale);
    if (url === undefined) return [];
    return [
      {
        id,
        href: url,
        title: docTitle(manifest, id, locale),
        lang: docTitleLang(manifest, id, locale),
      },
    ];
  }),
}));
---

<Page
  locale={locale}
  manifest={manifest}
  route={APP_ROUTES.search}
  title={pageTitle(t, t('search.pageTitle'))}
  description={`${t('search.label')}. ${t('site.description')}`}
>
  <div class="st-container st-stack st-stack-lg st-search">
    <Breadcrumb
      crumbs={[
        { href: href(locale, APP_ROUTES.home), label: t('nav.home') },
        { href: undefined, label: t('search.pageTitle') },
      ]}
      locale={locale}
    />
    <h1>{t('search.pageTitle')}</h1>

    <st-search-page
      class="st-stack"
      data-locale={search.locale}
      data-index={search.index}
      data-page={search.page}
      data-contents={search.contents}
      data-strings={search.strings}
    >
      <form class="st-search__form" action={search.page} method="get" role="search">
        <label for="st-search-q">{t('search.label')}</label>
        <div class="st-search__row">
          <input
            id="st-search-q"
            type="search"
            name="q"
            placeholder={t('search.placeholder')}
            autocomplete="off"
            enterkeyhint="search"
          />
          <Button type="submit" variant="primary">
            {t('search.button')}
          </Button>
        </div>
      </form>
      <section
        class="st-stack st-search__results js-only"
        aria-labelledby="search-results-title"
        data-search-region
        hidden
      >
        <h2 id="search-results-title" data-search-title>
          {t('search.resultsLabel')}
        </h2>
        <p class="st-search__status" role="status" aria-live="polite"></p>
        <div class="st-stack" data-search-list></div>
        <div class="st-stack" data-search-failed hidden>
          <p>{t('search.failed')}</p>
          <p>
            <a class="st-link-block" href={contentsHref}>
              {t('search.failedFallback')}
            </a>
          </p>
        </div>
      </section>
    </st-search-page>

    <div class="no-js-only">
      <Callout variant="info" label={t('search.dialogTitle')}>
        <p>{t('search.noJs')}</p>
        <p>
          <a class="st-link-block" href={contentsHref}>
            {t('search.browseContents')}
          </a>
        </p>
      </Callout>
    </div>

    {answers && answers.items.length > 0 && (
      <section class="st-stack" aria-labelledby="search-common">
        <h2 id="search-common">{t('search.commonQuestions')}</h2>
        <ul class="st-search__answers" role="list" lang={answersLangTag}>
          {answers.items.map((item) => (
            <li class="st-search__answer">
              <p class="st-search__question">
                <Inline runs={item.question} context={context} />
              </p>
              <p>
                <Inline runs={item.targets} context={context} />
                {item.note && (
                  <Fragment>
                    {' '}
                    <Inline runs={item.note} context={context} />
                  </Fragment>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="st-stack" aria-labelledby="search-all-pages">
      <h2 id="search-all-pages">{t('search.browseContents')}</h2>
      {sections.map((section) => (
        <section class="st-stack" aria-labelledby={`search-section-${section.id}`}>
          <h3 id={`search-section-${section.id}`}>{section.title}</h3>
          <ul class="st-search__pages" role="list">
            {section.docs.map((doc) => (
              <li>
                <a class="st-link-block" href={doc.href} lang={doc.lang}>
                  {doc.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p>
        <a class="st-link-block" href={contentsHref}>
          {t('contents.title')}
        </a>
      </p>
    </section>
  </div>
</Page>

<script>
  import '../../scripts/search-page';
</script>

<style>
  .st-search {
    padding-block: var(--st-space-5) var(--st-space-8);
  }

  .st-search__form {
    display: grid;
    gap: var(--st-space-2);
    max-inline-size: var(--st-measure);
  }

  .st-search__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--st-space-2);
  }

  .st-search__row input {
    flex: 1 1 16rem;
    min-inline-size: 0;
  }

  .st-search__results {
    max-inline-size: var(--st-measure);
  }

  .st-search__results[hidden],
  [data-search-failed][hidden] {
    display: none;
  }

  .st-search__status:empty {
    display: none;
  }

  .st-search__answers,
  .st-search__pages {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0;
    list-style: none;
    max-inline-size: var(--st-measure);
  }

  .st-search__answers {
    gap: var(--st-space-3);
  }

  .st-search__answer {
    padding-block-end: var(--st-space-3);
    border-block-end: var(--st-border-width) solid var(--st-border);
  }

  .st-search__question {
    font-weight: var(--st-weight-semibold);
  }
</style>

<style is:global>
  /*
   * The answer links are rendered by <Inline> (a docref), so this page's scoped styles cannot reach
   * them. Each stands alone on its line, so each is a full 44px target (review WP-20 pass 5).
   */
  .st-search__answer a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--st-target);
  }
</style>
