---
/**
 * `/about/`: how the guide was made, the licence, the keyboard shortcuts and the settings (build
 * plan B1).
 *
 * The shortcuts table lists only keys that work: `?`, Alt+← / Alt+→ and Escape (WP-30). The
 * search keys `/` and Ctrl+K join it when `SEARCH_AVAILABLE` is on (WP-33), because a row for a key
 * that does nothing would tell a reader something untrue. `?` on any page comes here
 * (`#keyboard-shortcuts`, the page's `<link rel="help">`).
 */
import Page from '../../layouts/Page.astro';
import Breadcrumb from '../../components/navigation/Breadcrumb.astro';
import Settings from '../../components/interactive/Settings.astro';
import Kbd from '../../components/ui/Kbd.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import { loadManifest } from '../../lib/content/collections';
import { docHref } from '../../lib/content/manifest';
import { localeStaticPaths } from '../../lib/i18n-routes';
import { pageTitle, splitAroundParam } from '../../lib/pages';
import { href } from '../../lib/paths';
import { APP_ROUTES, NAV_DOC_IDS, SEARCH_AVAILABLE } from '../../lib/routes';
import { SHORTCUTS_ANCHOR } from '../../lib/shortcuts';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
/** The guide's text licence, as `docs/rsa-business-toolkit/LICENSE.md` names it. */
const CONTENT_LICENCE = 'CC0 1.0';
const CONTENT_LICENCE_URL = 'https://creativecommons.org/publicdomain/zero/1.0/';
const t = useTranslations(locale);
const licenceParts = splitAroundParam((contentLicence) => t('about.licence', { contentLicence }));
const manifest = await loadManifest();
const howMadeHref = docHref(manifest, NAV_DOC_IDS.howThisWasMade, locale);
const sourcesHref = docHref(manifest, NAV_DOC_IDS.sources, locale);
const shortcutRows = [
  ...(SEARCH_AVAILABLE
    ? [
        { key: t('about.shortcuts.keys.slash'), action: t('about.shortcuts.search') },
        { key: t('about.shortcuts.keys.ctrlK'), action: t('about.shortcuts.search') },
      ]
    : []),
  { key: t('about.shortcuts.keys.question'), action: t('about.shortcuts.help') },
  { key: t('about.shortcuts.keys.altLeft'), action: t('about.shortcuts.previous') },
  { key: t('about.shortcuts.keys.altRight'), action: t('about.shortcuts.next') },
  { key: t('about.shortcuts.keys.escape'), action: t('about.shortcuts.escape') },
];
---

<Page
  locale={locale}
  manifest={manifest}
  route={APP_ROUTES.about}
  title={pageTitle(t, t('about.title'))}
  description={t('about.aiSummary')}
>
  <div class="st-container st-stack st-stack-lg st-about">
    <Breadcrumb
      crumbs={[
        { href: href(locale, APP_ROUTES.home), label: t('nav.home') },
        { href: undefined, label: t('about.title') },
      ]}
      locale={locale}
    />
    <h1>{t('about.title')}</h1>
    <p class="st-lead">{t('site.description')}</p>

    <section class="st-stack" aria-labelledby="about-ai">
      <h2 id="about-ai">{t('about.aiHeading')}</h2>
      <p>{t('site.disclaimerLong')}</p>
      <p class="st-cluster">
        {howMadeHref && (
          <a class="st-link-block" href={howMadeHref}>
            {t('about.aiLink')}
          </a>
        )}
        {sourcesHref && (
          <a class="st-link-block" href={sourcesHref}>
            {t('trust.sources.seeRegister')}
          </a>
        )}
      </p>
    </section>

    <section class="st-stack" aria-labelledby="about-licence">
      <h2 id="about-licence">{t('about.licenceHeading')}</h2>
      {/* One line on purpose: a line break here renders as a space inside "(CC0 1.0)". */}
      <!-- prettier-ignore -->
      <p>{licenceParts[0]}<a href={CONTENT_LICENCE_URL} rel="noopener noreferrer">{CONTENT_LICENCE}</a>{licenceParts[1]}</p>
    </section>

    <section class="st-stack" aria-labelledby={SHORTCUTS_ANCHOR}>
      <h2 id={SHORTCUTS_ANCHOR} tabindex="-1">
        {t('about.shortcuts.heading')}
      </h2>
      <table class="st-about__shortcuts">
        <thead>
          <tr>
            <th scope="col">{t('about.shortcuts.key')}</th>
            <th scope="col">{t('about.shortcuts.action')}</th>
          </tr>
        </thead>
        <tbody>
          {shortcutRows.map((row) => (
            <tr>
              <td>
                <Kbd>{row.key}</Kbd>
              </td>
              <td>{row.action}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="st-hint">{t('about.shortcuts.modifierNote')}</p>
      <p class="st-hint">{t('about.shortcuts.note')}</p>
    </section>

    <Settings locale={locale} headingId="about-settings" />
  </div>
</Page>

<style>
  .st-about {
    padding-block: var(--st-space-5) var(--st-space-8);
  }

  .st-about__shortcuts {
    max-inline-size: var(--st-measure);
  }
</style>
