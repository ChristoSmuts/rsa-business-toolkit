---
/**
 * `/templates/`: the five templates as tools (the card set's "tool" shape, WP-50 Phase 3; a page to
 * read while they cannot be filled in), plus "Which one do I need?" (build plan B6).
 * Each card opens the template's page, where it is filled in and printed (WP-32,
 * `TEMPLATES_FILLABLE`).
 */
import Page from '../../../layouts/Page.astro';
import Card from '../../../components/ui/Card.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Breadcrumb from '../../../components/navigation/Breadcrumb.astro';
import { formatDate, useTranslations, type TranslationKey } from '../../../i18n';
import type { Locale } from '../../../i18n/locales';
import { loadDoc, loadManifest } from '../../../lib/content/collections';
import { docHref, sectionDocIds } from '../../../lib/content/manifest';
import { localeStaticPaths } from '../../../lib/i18n-routes';
import { docContentLang, latestCheck, pageTitle } from '../../../lib/pages';
import { href } from '../../../lib/paths';
import { APP_ROUTES, NAV_DOC_IDS, TEMPLATES_FILLABLE } from '../../../lib/routes';

export function getStaticPaths() {
  return localeStaticPaths();
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const manifest = await loadManifest();
const intro = t(TEMPLATES_FILLABLE ? 'templates.indexIntro' : 'templates.indexIntroStatic');
const howMadeHref = docHref(manifest, NAV_DOC_IDS.howThisWasMade, locale);
const whichHref = docHref(manifest, 'paperwork/which-template-to-use-when', locale);

/** Template documents in the paperwork section's order; the slug is the dictionary key. */
const templates = sectionDocIds(manifest, 'paperwork')
  .filter((id) => manifest.docs[id]?.kind === 'template')
  .map((id) => {
    const slug = manifest.docs[id]?.slug ?? id;
    return {
      id,
      href: docHref(manifest, id, locale),
      name: t(`templates.items.${slug}.name` as TranslationKey),
      description: t(`templates.items.${slug}.description` as TranslationKey),
    };
  });
const templateDocs = await Promise.all(
  templates.map((item) => loadDoc(docContentLang(manifest, item.id, locale), item.id)),
);
const checkedOn = latestCheck(templateDocs.filter((doc) => doc !== undefined));
---

<Page
  locale={locale}
  manifest={manifest}
  route={APP_ROUTES.templates}
  title={pageTitle(t, t('templates.indexTitle'))}
  description={intro}
>
  <div class="st-container st-stack st-stack-lg st-templates" data-section="paperwork">
    <Breadcrumb
      crumbs={[
        { href: href(locale, APP_ROUTES.home), label: t('nav.home') },
        { href: undefined, label: t('templates.indexTitle') },
      ]}
      locale={locale}
    />
    <SectionHeader section="paperwork" title={t('templates.indexTitle')} level={1} />
    <p class="st-lead">{intro}</p>
    {whichHref && (
      <p>
        <a class="st-link-block" href={whichHref}>
          {t('templates.whichOne')}
        </a>
      </p>
    )}
    <ul class:list={['st-templates__list', !TEMPLATES_FILLABLE && 'st-rows']} role="list">
      {templates.map((item) => (
        <li>
          <Card
            title={item.name}
            href={item.href}
            section="paperwork"
            headingLevel={2}
            variant={TEMPLATES_FILLABLE ? 'tool' : 'page'}
            icon="lucide:notebook-pen"
            action={TEMPLATES_FILLABLE ? t('templates.open') : undefined}
            actionContext={item.name}
          >
            <p>{item.description}</p>
          </Card>
        </li>
      ))}
    </ul>
    {checkedOn && (
      <p class="st-hint">
        {t('site.checkedOn', { date: formatDate(locale, checkedOn) })}{' '}
        {howMadeHref && <a href={howMadeHref}>{t('trust.aiNotice.link')}</a>}
      </p>
    )}
  </div>
</Page>

<style>
  .st-templates {
    padding-block: var(--st-space-5) var(--st-space-8);
  }

  /* Each item is a grid, so its tool panel stretches to the row's height. */
  .st-templates__list:not(.st-rows) > li {
    display: grid;
  }

  .st-templates__list:not(.st-rows) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--st-space-4);
    padding: 0;
    list-style: none;
  }
</style>
