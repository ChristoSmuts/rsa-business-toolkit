---
/**
 * `/404.html`, served by GitHub Pages for every unknown URL under the site, in either language.
 * The server cannot tell which language the reader wanted, so the page says everything in both,
 * English first, each block with its own `lang`. Every link is absolute under the base path,
 * because the page is served at whatever URL was mistyped.
 *
 * With JavaScript, the block for the address's language suggests pages for the words in the
 * missing address (`<st-search-suggest>`, src/scripts/search-page.ts; build plan C4).
 */
import Base from '../layouts/Base.astro';
import Logo from '../components/illustrations/Logo.astro';
import Button from '../components/ui/Button.astro';
import { useTranslations } from '../i18n';
import { DEFAULT_LOCALE, ENABLED_LOCALES, getLocale } from '../i18n/locales';
import { href } from '../lib/paths';
import { loadManifest } from '../lib/content/collections';
import { APP_ROUTES, SEARCH_AVAILABLE } from '../lib/routes';
import { searchElementData } from '../lib/search/ui-data';
import '../styles/search.css';

const manifest = await loadManifest();

const blocks = ENABLED_LOCALES.map((locale) => {
  const t = useTranslations(locale);
  return {
    locale,
    lang: getLocale(locale)?.hreflang ?? locale,
    t,
    home: href(locale, APP_ROUTES.home),
    search: href(locale, APP_ROUTES.search),
    contents: href(locale, APP_ROUTES.contents),
    suggest: SEARCH_AVAILABLE ? searchElementData(locale, manifest) : undefined,
  };
});
const t = useTranslations(DEFAULT_LOCALE);
---

<Base
  lang="en"
  title={`${t('notFound.title')} · ${t('site.name')}`}
  description={t('notFound.body')}
  noindex
  skipLinkLabel={t('nav.skipLink')}
>
  <header slot="header" class="st-container st-notfound__header">
    <a class="st-notfound__home" href={href(DEFAULT_LOCALE, APP_ROUTES.home)}>
      <Logo />
    </a>
  </header>
  <div class="st-container st-stack st-stack-lg st-notfound">
    {blocks.map((block, index) => (
      <section class="st-stack" lang={block.lang} aria-labelledby={`notfound-${block.locale}`}>
        {index === 0 ? (
          <h1 id={`notfound-${block.locale}`}>{block.t('notFound.title')}</h1>
        ) : (
          <h2 id={`notfound-${block.locale}`}>{block.t('notFound.title')}</h2>
        )}
        <p>{block.t('notFound.body')}</p>
        {block.suggest && (
          <st-search-suggest
            class="st-notfound__suggest st-stack"
            data-locale={block.suggest.locale}
            data-index={block.suggest.index}
            data-page={block.suggest.page}
            data-contents={block.suggest.contents}
            data-strings={block.suggest.strings}
            hidden
          />
        )}
        {SEARCH_AVAILABLE && (
          <form class="st-notfound__search" action={block.search} method="get" role="search">
            <label for={`notfound-q-${block.locale}`}>{block.t('search.label')}</label>
            <div class="st-notfound__row">
              <input
                id={`notfound-q-${block.locale}`}
                type="search"
                name="q"
                placeholder={block.t('search.placeholder')}
                autocomplete="off"
              />
              <Button type="submit" variant="secondary">
                {block.t('search.button')}
              </Button>
            </div>
          </form>
        )}
        <p class="st-cluster">
          <a class="st-link-block" href={block.home}>
            {block.t('notFound.home')}
          </a>
          <a class="st-link-block" href={block.contents}>
            {block.t('notFound.contents')}
          </a>
        </p>
      </section>
    ))}
  </div>
</Base>

<script>
  import '../scripts/search-page';
</script>

<style>
  .st-notfound__header {
    padding-block: var(--st-space-3);
    border-block-end: var(--st-border-width) solid var(--st-border);
  }

  .st-notfound__home {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--st-target);
  }

  .st-notfound {
    padding-block: var(--st-space-6) var(--st-space-8);
    max-inline-size: var(--st-measure);
  }

  .st-notfound__suggest[hidden] {
    display: none;
  }

  .st-notfound__search {
    display: grid;
    gap: var(--st-space-2);
  }

  .st-notfound__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--st-space-2);
  }

  .st-notfound__row input {
    flex: 1 1 14rem;
    min-inline-size: 0;
  }
</style>
