  "terms": [
    {
      "meaning": "You trade as yourself. No company. The business and you are the same person in law.",
      "term": "Sole proprietor"
    },
    {
      "meaning": "The yearly tax return for people. Your business profit goes on it.",
      "term": "ITR12"
    },
    {
      "meaning": "Paying tax in advance, twice a year, because no employer deducts it for you.",
      "term": "Provisional tax"
    },
    {
      "meaning": "A business registered for VAT.",
      "term": "VAT vendor"
    },
    {
      "meaning": "Monthly payroll return / twice-yearly payroll reconciliation.",
      "term": "EMP201 / EMP501"
    },
    {
      "meaning": "Unemployment Insurance Fund, run by the Department of Employment and Labour. Your employees can claim from it when their job ends.",
      "term": "UIF"
    },
    {
      "meaning": "A debt you leave too long stops being claimable. Three years for most ordinary debts.",
