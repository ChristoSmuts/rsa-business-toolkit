              "t": "text",
              "v": "Status in Drive:"
            }
          ],
          "t": "strong"
        },
        {
          "t": "text",
          "v": " DONE. Created as \"01a Mood and materials - decide this before the logo\"."
        }
      ],
      "hash": "96e74c7fdd57f687",
      "id": "added-1.4",
      "kind": "paragraph"
