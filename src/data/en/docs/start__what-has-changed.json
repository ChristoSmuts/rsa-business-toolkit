      "depth": 3,
      "hash": "0b11e417176e57a6",
      "id": "lesson",
      "kind": "heading",
      "text": "Lesson"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "The root START HERE absorbed two markdown files, "
        },
        {
          "c": [
