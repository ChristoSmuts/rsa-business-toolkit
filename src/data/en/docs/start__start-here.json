    {
      "c": [
        {
          "t": "text",
          "v": "The short version of the whole toolkit"
        }
      ],
      "depth": 2,
      "hash": "4221055bf935a6f8",
      "id": "the-short-version-of-the-whole-toolkit",
      "kind": "heading",
      "text": "The short version of the whole toolkit"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "You do not need most of what people tell you to get."
        }
      ],
      "hash": "aba80cca9448ebf5",
      "id": "the-short-version-of-the-whole-toolkit.1",
      "kind": "paragraph"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "You can legally start selling today, as yourself, with no company registration, no logo, and no website. Earn money first. Add the formal parts as the business grows."
        }
      ],
      "hash": "c0475096793d5bd6",
      "id": "the-short-version-of-the-whole-toolkit.2",
      "kind": "paragraph"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "The four things that actually matter early:"
        }
      ],
      "hash": "1524d6145092c707",
      "id": "the-short-version-of-the-whole-toolkit.3",
      "kind": "paragraph"
    },
    {
      "hash": "9d8d8f4a674cf3ac",
      "id": "the-short-version-of-the-whole-toolkit.4",
      "items": [
        [
          {
            "t": "text",
            "v": "A separate bank account for business money"
          }
        ],
        [
          {
            "t": "text",
            "v": "Filing with SARS, even at zero income"
          }
        ],
        [
          {
            "t": "text",
            "v": "A licence, if your business type needs one, before you trade"
          }
        ],
        [
          {
            "t": "text",
            "v": "Records kept for five years"
          }
        ]
      ],
      "kind": "list",
      "ordered": true,
      "start": 1
    },
    {
      "c": [
        {
          "t": "text",
          "v": "Three numbers changed in 2026 and most websites still have them wrong:"
        }
      ],
      "hash": "2884abbae48997e1",
      "id": "the-short-version-of-the-whole-toolkit.5",
      "kind": "paragraph"
    },
    {
      "hash": "32627a6aa5641c24",
      "id": "the-short-version-of-the-whole-toolkit.6",
      "items": [
        [
          {
            "t": "text",
            "v": "Compulsory VAT registration: "
          },
          {
            "c": [
              {
                "t": "text",
                "v": "R2.3 million"
              }
            ],
            "t": "strong"
          },
          {
            "t": "text",
            "v": ", not R1 million, from 1 April 2026"
          }
        ],
        [
          {
            "t": "text",
            "v": "Voluntary VAT registration: "
          },
          {
            "c": [
              {
                "t": "text",
                "v": "R120,000"
              }
            ],
            "t": "strong"
          },
          {
            "t": "text",
            "v": ", not R50,000"
          }
        ],
        [
          {
            "t": "text",
            "v": "Turnover tax: "
          },
          {
            "c": [
              {
                "t": "text",
                "v": "R2.3 million"
              }
            ],
            "t": "strong"
          },
          {
            "t": "text",
            "v": " threshold, with "
          },
          {
            "c": [
              {
                "t": "text",
                "v": "0% on the first R600,000"
              }
            ],
            "t": "strong"
          }
        ]
      ],
      "kind": "list",
      "ordered": false
    },
