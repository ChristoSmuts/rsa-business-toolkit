      "c": [
        {
          "t": "text",
          "v": "A free toolkit for one person starting and running a business in South Africa. You are the owner. You are also the only worker."
        }
      ],
      "hash": "4a0fa76e8b118f31",
      "id": "intro.1",
      "kind": "paragraph"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "Written in simple English for readers who do not speak English as a first language, and for people who have never run a business before."
        }
      ],
      "hash": "ebfab643c555cbc0",
      "id": "intro.2",
      "kind": "paragraph"
