      "kind": "paragraph"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "AI can still be wrong, and South African rules change often. Before you pay money, sign something, or file something, open the official link in the sources file and confirm the number yourself."
        }
      ],
      "hash": "40e15c1596e89aa3",
      "id": "read-this-first.2",
      "kind": "paragraph"
    },
