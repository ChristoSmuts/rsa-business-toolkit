        {
          "key": "businessName",
          "style": "identity",
          "t": "placeholder",
          "v": "Business name"
        },
        {
          "t": "text",
          "v": " (\"we\", \"us\") respects your privacy. This notice explains what personal information we collect and what we do with it."
        }
      ],
      "hash": "1b520ec9600f2f5c",
      "id": "intro.4",
      "kind": "paragraph"
