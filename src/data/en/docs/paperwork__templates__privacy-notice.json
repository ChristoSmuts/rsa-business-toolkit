      "text": "What we collect"
    },
    {
      "hash": "9bb973ab3c2cb7dc",
      "id": "what-we-collect.1",
      "items": [
        [
          {
            "t": "text",
            "v": "Your name"
          }
        ],
        [
          {
            "t": "text",
            "v": "Your contact details (phone, email, address)"
          }
        ],
        [
          {
            "t": "text",
            "v": "Details of what you bought or asked about"
          }
        ],
        [
          {
            "t": "text",
            "v": "Payment information (we do not store card numbers)"
          }
        ]
      ],
      "kind": "list",
      "ordered": false
    },
    {
      "c": [
        {
          "t": "text",
          "v": "Add or remove lines so this is true for your business."
        }
      ],
