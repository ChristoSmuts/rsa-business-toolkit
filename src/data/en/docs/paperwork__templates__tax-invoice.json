      "id": "the-seven-things-a-full-tax-invoice-must-show.2",
      "items": [
        [
          {
            "t": "text",
            "v": "The words \"Tax Invoice\", \"VAT Invoice\" or \"Invoice\""
          }
        ],
        [
          {
            "t": "text",
            "v": "Your name, address and VAT registration number"
          }
        ],
        [
          {
            "t": "text",
            "v": "The customer's name and address, and their VAT number if they are registered"
          }
        ],
        [
          {
            "t": "text",
            "v": "A serial number and the date of issue"
          }
        ],
        [
          {
            "t": "text",
            "v": "A description of the goods or services supplied"
          }
        ],
        [
          {
            "t": "text",
            "v": "The quantity or volume supplied"
          }
        ],
        [
          {
            "t": "text",
            "v": "The value of the supply, the VAT charged, and the total"
