      "kind": "heading",
      "text": "The seven things a full tax invoice must show"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "For any supply over R5,000:"
        }
      ],
      "hash": "6bc0120a90e3c185",
      "id": "the-seven-things-a-full-tax-invoice-must-show.1",
      "kind": "paragraph"
    },
