    {
      "c": [
        {
          "t": "text",
          "v": "Number invoices in order with no gaps: INV-0001, INV-0002, INV-0003."
        }
      ],
      "hash": "63731d744ce88b51",
      "id": "invoice-numbering.1",
      "kind": "paragraph"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "A gap in the sequence looks like a hidden sale to SARS. If you cancel an invoice, do not delete it. Issue a credit note against it and keep both."
        }
      ],
      "hash": "94e00e2a928aab69",
      "id": "invoice-numbering.2",
      "kind": "callout",
      "style": "note"
    },
