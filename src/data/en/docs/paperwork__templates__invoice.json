      "c": [
        {
          "c": [
            {
              "t": "text",
              "v": "Use this one if you are NOT registered for VAT."
            }
          ],
          "t": "strong"
        },
        {
          "t": "text",
          "v": " That is most small businesses. You are not required to register until your turnover passes R2.3 million in any rolling 12 months."
        }
      ],
      "hash": "9f9df21d38816dc4",
      "id": "intro.1",
      "kind": "paragraph"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "Three rules you must follow on this invoice. Do NOT use the words \"Tax Invoice\". Do NOT show a VAT line. Do NOT show a VAT number. Do NOT add 15% to anything. Charging VAT when you are not registered is fraud, not a paperwork mistake."
        }
      ],
      "hash": "ba1396f383b9e33a",
      "id": "intro.2",
      "kind": "callout",
      "style": "note"
    },
    {
      "c": [
        {
          "t": "text",
          "v": "Make a copy, rename it to the invoice number, replace everything in [SQUARE BRACKETS], then export to PDF."
        }
      ],
      "hash": "0d887478b7732b07",
      "id": "intro.3",
