---
/**
 * A document page (build plan B6, WP-50 Phase 3 direction A). The top of the page, in order:
 *
 * 1. the breadcrumb on one line, with a dot in the section's hue before the section (there is no
 *    separate "Section:" label: it repeated the breadcrumb);
 * 2. the H1 and the lead;
 * 3. the read time; on a business type, the type's facts instead (`TypeFacts`, WP-50 Phase 3,
 *    item 3): the read time and the effort meter on one line, the hub's "Main reason" under them,
 *    and from 480px the type's illustration;
 * 4. the D5 AI notice (compact) and, on Afrikaans routes, the translation notice directly under it;
 *    on a business type, "Go straight to" (`TypeJump`) after them;
 * 5. two closed disclosures with a chevron: "On this page (N sections)" and "Words used on this
 *    page" (closed at every width since WP-50 Phase 3; B6 had it open from 1024px);
 * 6. the text, then "Sources for this page" and the pager.
 *
 * From 1280px the contents column sits on the right: h2 entries only, muted, underlined only on
 * hover and focus (`.st-quiet-links`). There is no left section sidebar: the breadcrumb and the
 * header's Read menu lead to the section, and the article gets the room.
 *
 * Additions by kind of page:
 * - the hub ("Pick your business type") gets the six type tiles with their effort meters;
 * - a business-type document gets its facts, "Go straight to" and the related-type hints, and
 *   "Only what applies to me" only when it can hide more than the page's own kind of business
 *   (`docHasConditions(doc, type)`). Its first line
 *   already says "Read Core first" with a link to Core, so the separate callout is shown only on a
 *   type whose text does not (`saysReadCoreFirst`);
 * - the master checklist says it is a reminder list, not proof of compliance (D5);
 * - a template says when its required-content rules were checked (D5).
 *
 * On a short phone screen (below 768px wide and 740px high, so 320×568 and 360×640) and on a
 * landscape phone (below 500px high: 800×360, 844×390, 915×412) the AI notice must still be on the
 * first screen (Stoep rule 9, ADR 0006; WP-50a) under today's two- and three-row header, so there
 * the notices come straight after the H1 and the lead and the meta line (`st-doc__after-notice`)
 * follow them, and the page starts 8px under the header. Only their order on screen changes;
 * neither has a link or control, so the order of focus and of reading is the same either way.
 * Known gaps until the header is one row (WP-50 Phase 3, item 5), measured on all 74 documents
 * (docs/design-system.md, "AI notice"): with JavaScript, `af/start/start-here/` at 568×320; without
 * it (a 213px header below 1024px), every page at 360px high, 13 at 844×390 and 9 at 915×412,
 * where the H1 takes two lines.
 *
 * `assertDocTrust` runs first, so a document that would render without sources and without a
 * source note fails the build instead of shipping (D5).
 */
import pathsData from '../data/paths.json';
import Page from './Page.astro';
/*
 * The effort table's row map (`pickTable`) is not in the `businessTypes` collection: that collection
 * is the file's `types` array, one entry per kind of business, and `pickTable` belongs to the
 * table, not to a type. Reading the same file here, rather than copying the map into each type or
 * adding a one-entry collection, keeps one source that `content:check` already validates.
 */
import businessTypesFile from '../../content-meta/business-types.json';
import BusinessTypeTiles from '../components/pages/BusinessTypeTiles.astro';
import TypeFacts from '../components/pages/TypeFacts.astro';
import TypeJump from '../components/pages/TypeJump.astro';
import ChecklistElsewhere from '../components/interactive/ChecklistElsewhere.astro';
import AppliesScope from '../components/interactive/AppliesScope.astro';
import AppliesSwitch from '../components/interactive/AppliesSwitch.astro';
import ChecklistSummary from '../components/interactive/ChecklistSummary.astro';
import Badge from '../components/ui/Badge.astro';
import Callout from '../components/ui/Callout.astro';
import Blocks from '../components/content/Blocks.astro';
import TermsBlock from '../components/content/TermsBlock.astro';
import Breadcrumb from '../components/navigation/Breadcrumb.astro';
import TableOfContents from '../components/navigation/TableOfContents.astro';
import AiNotice from '../components/trust/AiNotice.astro';
import SourcesForPage from '../components/trust/SourcesForPage.astro';
import TranslationNotice from '../components/trust/TranslationNotice.astro';
import TemplateTool from '../components/templates/TemplateTool.astro';
import { formatDate, useTranslations } from '../i18n';
import { DEFAULT_LOCALE, getLocale, type Locale } from '../i18n/locales';
import { createContentContext } from '../lib/content/context';
import { docHref, docTitle, sectionHref, sectionTitle } from '../lib/content/manifest';
import type { BusinessType, Doc, GlossaryFile, Manifest, SourcesFile } from '../lib/content/schema';
import { splitTermsBlocks, TERMS_HEADING_ID } from '../lib/content/render';
import { hasOwnSources } from '../lib/content/trust';
import { documentCrumbs } from '../lib/nav';
import { assertDocTrust, docPager, pageTitle, sectionHue, splitAroundParam } from '../lib/pages';
import { docHasConditions } from '../lib/path-pages';
import { effortReason, glanceLinks } from '../lib/business-types';
import { href } from '../lib/paths';
import { APP_ROUTES, CHECKLIST_SAVES, TEMPLATES_FILLABLE, WIZARD_AVAILABLE } from '../lib/routes';
import { isTemplateSlug } from '../lib/templates/draft';
import { formHowToKey, formIntro } from '../lib/templates/intro';
import { parseTemplate } from '../lib/templates/placeholders';

interface Props {
  locale: Locale;
  manifest: Manifest;
  /** The document in the language it is rendered in (English when not translated yet). */
  doc: Doc;
  glossary: GlossaryFile | undefined;
  sources: SourcesFile | undefined;
  /** The language `sources` is in; English until `lookup/sources` is translated. */
  sourcesLang: Locale;
  /** The English register when `sources` is not English (`ContentContext.keptInEnglish`). */
  englishSources?: SourcesFile | undefined;
  /** Every business type, for the effort meter and the related-type hints. */
  businessTypes: readonly BusinessType[];
  /**
   * On a business type: "Pick your business type" in the page's content language and in English,
   * for the effort table's "Main reason" in the type's facts (`TypeFacts`).
   */
  typeHub?: { doc: Doc; english: Doc } | undefined;
}

const {
  locale,
  manifest,
  doc,
  glossary,
  sources,
  sourcesLang,
  englishSources,
  businessTypes,
  typeHub,
} = Astro.props;
/** The document that is the business-types hub; B6 gives it the type tiles above its text. */
const BUSINESS_TYPES_HUB = 'business-types/pick-your-business-type';
assertDocTrust(doc);

const t = useTranslations(locale);
const route = doc.route;
const contentLang = doc.lang as Locale;
const isFallback = contentLang !== locale;
const contentLangTag = isFallback ? (getLocale(contentLang)?.hreflang ?? contentLang) : undefined;
const businessType = businessTypes.find((type) => type.doc === doc.id);
const context = createContentContext({
  locale,
  contentLang,
  manifest,
  glossary,
  sources,
  sourcesLang,
  englishSources,
  docId: doc.id,
  ownBusinessType: businessType?.id,
});

const section = sectionTitle(manifest, doc.section, locale);
const title = docTitle(manifest, doc.id, locale);
const crumbs = documentCrumbs(manifest, doc.id, locale, t);
const pager = docPager(manifest, doc.id, locale);
const previousParts = splitAroundParam((title) => t('nav.previous', { title }));
const nextParts = splitAroundParam((title) => t('nav.next', { title }));
const hue = sectionHue(doc.section);
const { terms, rest } = splitTermsBlocks(doc.blocks);
/**
 * A template becomes a form with a live preview (WP-32): its text before and after the template
 * renders as on any document, and the template itself is `TemplateTool`. Its headings are the
 * form's groups, so it has no contents list of its own.
 */
const templateSlug = doc.kind === 'template' && isTemplateSlug(doc.slug) ? doc.slug : undefined;
const template = TEMPLATES_FILLABLE && templateSlug ? parseTemplate(doc) : undefined;
/*
 * Above the form, the markdown's "make a copy … export to PDF" note (for the file) gives way to a
 * line about the form, in the language of the template's text (`src/lib/templates/intro.ts`).
 */
const howToKey = templateSlug ? formHowToKey(templateSlug) : undefined;
const templateIntro = template
  ? formIntro(template.before, howToKey ? useTranslations(contentLang)(howToKey) : undefined)
  : [];
const translationStatus = isFallback ? 'fallback' : doc.translation.status;
const englishHref = locale === DEFAULT_LOCALE ? undefined : href(DEFAULT_LOCALE, route);

const coreHref = sectionHref(manifest, 'core', locale);
/**
 * Every business type's text opens with "Read [Core] first. This file adds …", the link included,
 * in both languages. A type whose first paragraph says so needs no second "Read Core first"; one
 * that does not (a new type, or an edited intro) still gets the callout, so nothing is lost.
 */
const firstParagraph = rest.find((block) => block.kind === 'paragraph');
const saysReadCoreFirst =
  firstParagraph?.kind === 'paragraph' &&
  firstParagraph.c.some((run) => run.t === 'docref' && 'section' in run && run.section === 'core');
/*
 * "Only what applies to me" (WP-31): on a page with parts for one entity or some kinds of business.
 * The master checklist has its own "Show: Only what applies to me" choice instead of the switch.
 */
const filterable = WIZARD_AVAILABLE && docHasConditions(doc, businessType?.id);
/** A business type's facts: the hub's "Main reason" for its effort (WP-50 Phase 3, item 3). */
const glanceReason =
  businessType && typeHub
    ? effortReason(businessTypesFile.pickTable, typeHub.english, typeHub.doc, businessType.id)
    : undefined;
const glanceReasonLang =
  typeHub && typeHub.doc.lang !== locale
    ? (getLocale(typeHub.doc.lang as Locale)?.hreflang ?? typeHub.doc.lang)
    : undefined;
const scopeMode = doc.kind === 'checklist' ? 'checklist' : 'switch';
const showSwitch = filterable && scopeMode === 'switch';
const relatedTypes = businessType
  ? doc.related
      .map((id) => businessTypes.find((type) => type.doc === id))
      .filter((type): type is BusinessType => type !== undefined && type.id !== businessType.id)
  : [];
---

<Page
  locale={locale}
  manifest={manifest}
  route={route}
  title={pageTitle(t, title, section)}
  description={doc.summary}
  ogType="article"
>
  <div class:list={['st-container st-doc', { 'st-doc--tool': template }]} data-section={hue}>
    <div class="st-stack st-stack-lg st-doc__main">
      <Breadcrumb crumbs={crumbs} locale={locale} sectionDot />

      <article class="st-stack st-stack-lg" data-doc={doc.id} data-kind={doc.kind}>
        <header class="st-stack st-doc__header">
          <h1 lang={contentLangTag}>{doc.h1}</h1>
          <p class="st-lead st-doc__lead st-doc__after-notice" lang={contentLangTag}>
            {doc.summary}
          </p>
          {businessType ? (
            <TypeFacts
              locale={locale}
              type={businessType}
              reason={glanceReason}
              reasonLang={glanceReasonLang}
              context={context}
            >
              <Badge variant="status" icon="lucide:clock" bare>
                {t('doc.readTime', { minutes: doc.readingTime })}
              </Badge>
              {doc.appliesTo.entity !== 'all' && (
                <Badge variant="entity" bare>
                  {doc.appliesTo.entity === 'pty' ? t('doc.ptyOnly') : t('doc.soleProprietorOnly')}
                </Badge>
              )}
            </TypeFacts>
          ) : (
            <p class="st-cluster st-doc__meta st-doc__after-notice">
              <Badge variant="status" icon="lucide:clock" bare>
                {t('doc.readTime', { minutes: doc.readingTime })}
              </Badge>
              {doc.appliesTo.entity !== 'all' && (
                <Badge variant="entity" bare>
                  {doc.appliesTo.entity === 'pty' ? t('doc.ptyOnly') : t('doc.soleProprietorOnly')}
                </Badge>
              )}
            </p>
          )}
          <AiNotice
            verification={doc.verification}
            hasPageSources={hasOwnSources(doc.sources)}
            locale={locale}
            manifest={manifest}
          />
          <TranslationNotice status={translationStatus} locale={locale} englishHref={englishHref} />
          {businessType && (
            <TypeJump
              locale={locale}
              links={glanceLinks(businessType, doc)}
              contentLang={contentLangTag}
            />
          )}
        </header>

        {!template && (
          <TableOfContents
            headings={doc.headings}
            locale={locale}
            variant="details"
            contentLang={contentLangTag}
          />
        )}

        {(terms || showSwitch) && (
          <div class="st-stack st-stack-sm st-doc__more">
            {terms && (
              <details class="st-disclosure st-doc__terms" id={TERMS_HEADING_ID}>
                <summary>{t('doc.wordsUsed')}</summary>
                <div class="st-doc__terms-body" lang={contentLangTag}>
                  <TermsBlock block={terms} context={context} />
                </div>
              </details>
            )}
            {showSwitch && <AppliesSwitch locale={locale} />}
          </div>
        )}

        {businessType && coreHref && !saysReadCoreFirst && (
          <Callout variant="info" label={t('doc.readCoreFirstTitle')}>
            <p>{t('doc.readCoreFirst')}</p>
            <p>
              <a class="st-link-block" href={coreHref}>
                {t('doc.readCoreFirstAction')}
              </a>
            </p>
          </Callout>
        )}

        {doc.kind === 'checklist' && (
          <Callout variant="note" label={t('doc.note')}>
            <p>{t('trust.checklistReminder')}</p>
          </Callout>
        )}

        {doc.kind === 'checklist' && CHECKLIST_SAVES && (
          <ChecklistSummary locale={locale} doc={doc} />
        )}

        {doc.kind === 'template' && (
          <Callout variant="note" label={t('doc.note')}>
            <p>
              {t('trust.templateRulesChecked', {
                date: formatDate(locale, doc.verification.checkedOn),
              })}
            </p>
          </Callout>
        )}

        {doc.id === BUSINESS_TYPES_HUB && (
          <section class="st-stack" aria-labelledby="st-hub-tiles">
            <h2 id="st-hub-tiles">{t('businessTypesHub.ifYouHeading')}</h2>
            <p>{t('home.businessTypes.lead')}</p>
            <BusinessTypeTiles
              locale={locale}
              manifest={manifest}
              businessTypes={businessTypes}
              general={false}
            />
          </section>
        )}

        {template && templateSlug ? (
          <Fragment>
            <Blocks blocks={templateIntro} context={context} fallbackCaption={doc.title} />
            <TemplateTool
              locale={locale}
              slug={templateSlug}
              model={template}
              context={context}
              textLang={contentLangTag}
            />
            <Blocks blocks={template.after} context={context} fallbackCaption={doc.title} />
          </Fragment>
        ) : filterable ? (
          <AppliesScope locale={locale} mode={scopeMode}>
            <Blocks blocks={rest} context={context} fallbackCaption={doc.title} />
          </AppliesScope>
        ) : (
          <Blocks blocks={rest} context={context} fallbackCaption={doc.title} />
        )}

        {doc.kind === 'checklist' && CHECKLIST_SAVES && (
          <ChecklistElsewhere locale={locale} manifest={manifest} docId={doc.id} />
        )}

        {relatedTypes.length > 0 && (
          <section class="st-stack" aria-labelledby="st-related-types">
            <h2 id="st-related-types">{t('doc.related.heading')}</h2>
            <p>{t('doc.related.lead')}</p>
            <ul class="st-stack st-stack-sm" role="list">
              {relatedTypes.map((type) => (
                <li>
                  <a class="st-link-block" href={docHref(manifest, type.doc, locale)}>
                    {t('doc.related.item', { name: t(`businessTypes.${type.id}.name`) })}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <SourcesForPage
          sources={doc.sources}
          sourceNote={doc.sourceNote}
          context={context}
          locale={locale}
          id="sources-for-this-page"
        />
      </article>

      {(pager.previous || pager.next) && (
        <st-path-pager
          data-doc={doc.id}
          data-locale={locale}
          data-version={pathsData.hash}
          data-my-path={href(locale, APP_ROUTES.myPath)}
          data-my-path-title={t('nav.myPath')}
        >
          <nav class="st-pager" aria-label={t('nav.pagerLabel')}>
            {pager.previous && (
              <a class="st-pager__link" href={pager.previous.href} rel="prev">
                <span>
                  {previousParts[0]}
                  <span lang={pager.previous.lang} data-pager-title>
                    {pager.previous.title}
                  </span>
                  {previousParts[1]}
                </span>
              </a>
            )}
            {pager.next && (
              <a class="st-pager__link st-pager__next" href={pager.next.href} rel="next">
                <span>
                  {nextParts[0]}
                  <span lang={pager.next.lang} data-pager-title>
                    {pager.next.title}
                  </span>
                  {nextParts[1]}
                </span>
              </a>
            )}
          </nav>
        </st-path-pager>
      )}
    </div>

    {!template && (
      <TableOfContents
        headings={doc.headings}
        locale={locale}
        variant="column"
        contentLang={contentLangTag}
      />
    )}
  </div>
</Page>

<script>
  import '../scripts/path-progress';
</script>

<style is:global>
  /*
   * Spacing between other components' elements (the breadcrumb, the contents list's `<st-toc>`),
   * so global, and held to `.st-doc`. The breadcrumb sits 8px above the H1: its link is a 44px
   * target, which already leaves room.
   */
  .st-doc__main > .st-breadcrumb {
    margin-block-end: calc(var(--st-space-2) - var(--st-space-6));
  }

  /*
   * The two disclosures, and the "Only what applies to me" switch, read as one group 16px under
   * the notices and 8px apart, not the article's 32px. (The "Now reading" pill track between them
   * takes back its own gap, `TableOfContents.astro`.) From 1280px the contents are the column
   * instead. A page with neither keeps 32px between the notices and its text.
   */
  .st-doc article > st-toc > .st-toc--details,
  .st-doc article > .st-doc__more {
    margin-block-start: calc(var(--st-space-4) - var(--st-space-6));
  }

  /*
   * A business type's facts and its "Go straight to" links (other components, so global). On a
   * short phone screen the facts follow the lead and the meta line after the notices, as they do in
   * the HTML, and the links stay last (see the scoped rule for `.st-doc__after-notice`).
   */

  /* Under "Go straight to" (44px targets, their words centred) the contents sit 8px down, not 16px. */
  .st-doc article > header:has(> .st-type-jump) + st-toc > .st-toc--details {
    margin-block-start: calc(var(--st-space-2) - var(--st-space-6));
  }

  @media (width < 768px) and (height < 740px), (orientation: landscape) and (height < 500px) {
    .st-doc__header > .st-type-facts {
      order: 1;
    }

    .st-doc__header > .st-type-jump {
      order: 2;
    }
  }

  @media (width < 1280px) {
    .st-doc article > st-toc ~ .st-doc__more {
      margin-block-start: calc(var(--st-space-2) - var(--st-space-6));
    }
  }
</style>

<style>
  st-path-pager {
    display: block;
  }

  /*
   * One column; from 1280px the article and the contents column on its right. No left sidebar
   * (WP-50 Phase 3): the breadcrumb and the header's Read menu lead to the section.
   */
  .st-doc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-7);
    padding-block: var(--st-space-5) var(--st-space-8);
  }

  @media (width >= 1280px) {
    .st-doc {
      grid-template-columns: minmax(0, 1fr) var(--st-toc);
    }

    /* A fillable template has no contents column: the form and its preview take the room. */
    .st-doc--tool {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* A phone, upright or on its side: the breadcrumb's 44px target already leaves room above it. */
  @media (width < 768px), (orientation: landscape) and (height < 500px) {
    .st-doc {
      padding-block-start: var(--st-space-2);
    }
  }

  .st-doc__main {
    min-inline-size: 0;
  }

  /*
   * The top of the article sits closer together than the text below it: the title block is one
   * thing to read, and on a phone every 8px decides whether the text starts on the second screen.
   * The header is 12px apart inside.
   */
  .st-doc__header {
    --st-stack-gap: var(--st-space-3);
  }

  .st-doc__meta {
    --st-cluster-gap: var(--st-space-2) var(--st-space-4);
  }

  /*
   * A short phone screen or a landscape phone (see the comment at the top): the AI notice and the
   * translation notice straight after the H1, the lead and the meta line after them, so the notice
   * is on the first screen at 320×568 and 800×360 under today's header. Taller phones and laptops
   * (a landscape screen 500px high or more) keep the order of the HTML.
   */
  @media (width < 768px) and (height < 740px), (orientation: landscape) and (height < 500px) {
    .st-doc__header > .st-doc__after-notice {
      order: 1;
    }
  }

  .st-doc__terms {
    max-inline-size: var(--st-measure);
  }

  .st-doc__terms-body {
    padding-block: var(--st-space-2) var(--st-space-3);
  }

  .st-pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--st-space-3);
    padding-block-start: var(--st-space-5);
    border-block-start: var(--st-border-width) solid var(--st-border);
  }

  /*
   * One inline <span> holds the whole sentence ("Previous: {title}", the title in its own
   * `<span lang>`), so it flows as one flex item: as separate items the space after the colon
   * collapsed and the label broke mid-word (review WP-20 pass 3).
   */
  .st-pager__link {
    display: flex;
    align-items: center;
    min-block-size: var(--st-target);
    padding: var(--st-space-3) var(--st-space-4);
    border: var(--st-border-width) solid var(--st-border-strong);
    border-radius: var(--st-radius-md);
    overflow-wrap: anywhere;
  }

  @media (width >= 768px) {
    .st-pager {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .st-pager__next {
      grid-column: 2;
      justify-content: flex-end;
      text-align: end;
    }
  }
</style>
